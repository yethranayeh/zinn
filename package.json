{
	"name": "zinn",
	"private": true,
	"workspaces": [
		"packages/*",
		"docs"
	],
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev-cli.ts",
		"dev:seed": "bun scripts/seed-dev.ts",
		"test:node": "node --test packages/core/src/sqlite/node.check.ts",
		"docs:dev": "bun run --cwd docs dev",
		"docs:build": "bun run --cwd docs build",
		"docs:check": "bun run --cwd docs check",
		"docs:deploy": "bun run --cwd docs deploy",
		"docs:preview": "bun run --cwd docs preview"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	}
}
