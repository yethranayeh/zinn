{
	"name": "zinn",
	"private": true,
	"workspaces": [
		"packages/*",
		"integrations/opencode/panel",
		"docs"
	],
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev-cli.ts",
		"dev:seed": "bun scripts/seed-dev.ts",
		"settings-schema": "bun scripts/settings-schema.ts",
		"test": "bun test --timeout 30000 packages scripts",
		"typecheck": "bun scripts/typecheck.ts",
		"test:node": "node --test packages/core/src/sqlite/node.check.ts",
		"test:stress": "bun scripts/stress/index.ts",
		"docs:dev": "bun run --cwd docs dev",
		"docs:build": "bun run --cwd docs build",
		"docs:check": "bun run --cwd docs check",
		"docs:deploy": "bun run --cwd docs deploy",
		"docs:preview": "bun run --cwd docs preview",
		"opencode:test": "bun run --cwd integrations/opencode/panel test",
		"opencode:typecheck": "bun scripts/typecheck.ts integrations/opencode/panel"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	}
}
