---
import { render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import ChangelogIntro from "../components/changelog/ChangelogIntro.astro";
import Release from "../components/changelog/Release.astro";
import ReleaseContents from "../components/changelog/ReleaseContents.astro";
import ReleaseNoteHeading from "../components/changelog/ReleaseNoteHeading.astro";
import MarkdownH1 from "../components/MarkdownH1.astro";

import { getReleases } from "../config/changelog";
import { components } from "../markdown/components";

const noteComponents = { ...components, h3: ReleaseNoteHeading };
const releases = await getReleases();
const rendered = await Promise.all(
	releases.map(async (release) => ({ release, Content: (await render(release.entry)).Content }))
);
---

<BaseLayout
	title='Changelog'
	description='Release notes for Zinn, a kanban CLI and core library, and its integrations, including breaking changes and database upgrades.'>
	<ChangelogIntro>
		<MarkdownH1 id='changelog'>CHANGELOG</MarkdownH1>
		<p>
			Notable changes to Zinn and its integrations. Each CLI release names the core version it includes, and
			integrations release on their own versions. <strong>Breaking</strong> changes include the action needed when upgrading.
		</p>
	</ChangelogIntro>

	<div class='relative'>
		{
			rendered.map(({ release, Content }, index) => (
				<Release {...release} first={index === 0}>
					<Content components={noteComponents} />
				</Release>
			))
		}
		<ReleaseContents releases={releases} />
	</div>
</BaseLayout>
