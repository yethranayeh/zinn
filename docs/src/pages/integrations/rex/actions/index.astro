---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Button from "../../../../components/ui/button/Button.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import ActionContentBlocks from "../../../../components/rex-actions/ActionContentBlocks.astro";
import ActionDescription from "../../../../components/rex-actions/ActionDescription.astro";
import ActionPaletteFlow from "../../../../components/rex-actions/ActionPaletteFlow.astro";
import ActionSection from "../../../../components/rex-actions/ActionSection.astro";
import ActionSummaryItem from "../../../../components/rex-actions/ActionSummaryItem.astro";
import InlineText from "../../../../components/inspector/InlineText.astro";
import Icon from "../../../../components/ui/icon/Icon.astro";
import InsertTaskFigure from "../../../../components/rex-actions/InsertTaskFigure.astro";
import MarkdownH1 from "../../../../components/MarkdownH1.astro";

import { actionIntroduction, actionSections, actionSummaries } from "../../../../components/rex-actions/content";
import { projectLinks } from "../../../../config/site";
import { rexActions } from "../../../../config/rex-actions";
---

<BaseLayout title='Rex actions' description={rexActions.description}>
	<div class='site-container py-8 md:py-12'>
		<Breadcrumbs />

		<section class='pb-9 md:pb-12' aria-labelledby='actions-heading'>
			<MarkdownH1 id='actions-heading'>{rexActions.title}</MarkdownH1>
			<div class='grid gap-7 md:grid-cols-[1.1fr_1fr] md:items-end md:gap-12'>
				<div class='max-w-md text-lg leading-relaxed'>
					<p><InlineText text={actionIntroduction} /></p>
					<ul class='mt-4 grid gap-2'>
						{
							actionSummaries.map(({ action, description }) => (
								<ActionSummaryItem action={action} description={description} />
							))
						}
					</ul>
				</div>
				<div class='flex flex-wrap gap-3 md:justify-end'>
					<Button href='#installation' variant='solid' size='large'>Installation</Button>
					<Button href='#keys-and-arguments' variant='outline' size='large'>Keys and arguments</Button>
				</div>
			</div>
		</section>

		<div class='pb-10 md:pb-12'>
			<InsertTaskFigure />
		</div>
	</div>

	{
		actionSections.map((section) => (
			<ActionSection
				id={section.id}
				headingId={section.headingId}
				title={section.title}
				surface={section.surface}
				titleSide={section.titleSide}>
				{section.id === "actions" && <ActionPaletteFlow slot='visualization' />}
				{section.actions?.map((action, index) => (
					<ActionDescription title={action.title} blocks={action.blocks} first={index === 0} />
				))}
				{section.blocks && <ActionContentBlocks blocks={section.blocks} />}
			</ActionSection>
		))
	}

	<div class='site-container'>
		<div class='flex flex-wrap items-center justify-between gap-5 border-t border-pewter pt-6'>
			<a class='inline-flex min-h-11 items-center gap-2 font-mono text-xs' href='/integrations/rex/theme'
				>Zinn theme for Rex</a
			>
			<a
				class='inline-flex min-h-11 items-center gap-2 font-mono text-xs'
				href={`${projectLinks.github}/tree/main/integrations/rex/zinn`}>Actions source <Icon name='external-link' /></a
			>
		</div>
	</div>
</BaseLayout>
