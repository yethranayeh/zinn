---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Button from "../../../../components/ui/button/Button.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import Icon from "../../../../components/ui/icon/Icon.astro";
import Link from "../../../../components/ui/link/Link.astro";
import MarkdownH1 from "../../../../components/MarkdownH1.astro";
import PaletteStrip from "../../../../components/PaletteStrip.astro";
import Prose from "../../../../components/Prose.astro";

import { firefoxTheme } from "../../../../config/firefox-theme";
import { projectLinks } from "../../../../config/site";

const [halftone, lattice] = firefoxTheme.themes;
---

<BaseLayout title='Firefox theme' description={firefoxTheme.description}>
	<div class='site-container py-8 md:py-12'>
		<Breadcrumbs />

		<section class='pb-9 md:pb-12' aria-labelledby='theme-heading'>
			<MarkdownH1 id='theme-heading'>{firefoxTheme.title}</MarkdownH1>
			<div class='grid gap-7 md:grid-cols-[1.1fr_1fr] md:items-end md:gap-12'>
				<div>
					<p class='max-w-md text-lg leading-relaxed'>{firefoxTheme.introduction}</p>
					<div class='mt-6'><PaletteStrip /></div>
				</div>
				<div class='flex flex-wrap gap-3 md:justify-end'>
					<Button href={halftone.addonUrl} variant='solid' size='large'
						>Install Halftone <Icon name='external-link' /></Button
					>
					<Button href={lattice.addonUrl} variant='outline' size='large'
						>Install Lattice <Icon name='external-link' /></Button
					>
				</div>
			</div>
		</section>

		<section id='textures' aria-labelledby='textures-heading' class='border-t border-pewter pt-8 pb-10 md:pb-12'>
			<h2 id='textures-heading' class='text-3xl leading-tight tracking-tight md:text-4xl'>Two textures</h2>
			<p class='mt-5 max-w-xl text-lg leading-relaxed'>
				Both themes use the same palette. They differ in the texture across the tab strip and toolbar.
			</p>

			<div class='mt-8 grid gap-10 md:mt-10 md:gap-12'>
				{
					firefoxTheme.themes.map((theme, index) => (
						<article id={theme.id} class='grid gap-5 md:grid-cols-[1fr_1.5fr] md:items-center md:gap-12'>
							<div>
								<h3 class='text-2xl leading-tight tracking-tight md:text-3xl'>{theme.name}</h3>
								<p class='mt-3 max-w-sm text-lg leading-relaxed'>{theme.description}</p>
							</div>
							<figure>
								<img
									class='block h-auto w-full border border-pewter'
									src={theme.image}
									alt={theme.imageAlt}
									width='680'
									height='92'
									loading={index === 0 ? "eager" : "lazy"}
									decoding='async'
								/>
								<figcaption class='mt-3 font-mono text-xs'>Firefox, light appearance</figcaption>
							</figure>
						</article>
					))
				}
			</div>
		</section>

		<section
			id='installation'
			aria-labelledby='installation-heading'
			class='grid gap-7 border-t border-pewter pt-8 pb-6 md:grid-cols-2 md:gap-12'>
			<div>
				<h2 id='installation-heading' class='max-w-sm text-3xl leading-tight tracking-tight md:text-4xl'>
					Install a theme
				</h2>
				<p class='mt-5 max-w-sm text-lg leading-relaxed'>
					Both themes install from Mozilla Add-ons. Firefox applies the one you choose right away.
				</p>
			</div>
			<div class='min-w-0'>
				<Prose>
					<ol class='space-y-4'>
						<li>
							Open <Link href={halftone.addonUrl}>Zinn Halftone</Link> or{" "}
							<Link href={lattice.addonUrl}>Zinn Lattice</Link> on Mozilla Add-ons.
						</li>
						<li>Choose Add to Firefox.</li>
						<li>Open <code>about:addons</code> and select Themes to switch or remove a theme.</li>
					</ol>

					<p>
						Requires {firefoxTheme.minimumVersion} or later. The theme follows the system light and dark appearance.
					</p>
				</Prose>
			</div>
		</section>

		<div class='flex flex-wrap items-center justify-between gap-5 border-t border-pewter pt-6'>
			<p class='font-mono text-xs'>Verified with {firefoxTheme.verifiedVersion}</p>
			<a
				class='inline-flex min-h-11 items-center gap-2 font-mono text-xs'
				href={`${projectLinks.github}/tree/main/integrations/firefox/theme`}
				>Theme source <Icon name='external-link' /></a
			>
		</div>
	</div>
</BaseLayout>
