---
import PageLayout from "../../layouts/PageLayout.astro";
import Chip from "../../components/ui/chip/Chip.astro";
import Icon from "../../components/ui/icon/Icon.astro";
import MarkdownH1 from "../../components/MarkdownH1.astro";

import { opencodeInspector } from "../../config/opencode-inspector";
import { opencodeScenes, opencodeTheme } from "../../config/opencode-theme";
import { cloudinaryImage } from "../../images/cloudinary";

const preview = opencodeScenes.find((scene) => scene.id === "code")!;
---

<PageLayout title='Integrations' description='Themes and integrations maintained by Zinn.'>
	<MarkdownH1>Integrations</MarkdownH1>

	<p class='max-w-xl text-lg leading-relaxed'>Themes and integrations maintained by Zinn.</p>

	<a class='group mt-10 block max-w-3xl border border-pewter no-underline hover:no-underline' href={opencodeTheme.path}>
		<img
			class='aspect-[2840/1640] h-auto w-full'
			src={cloudinaryImage(preview.images.dark!, 1280)}
			alt='The Zinn theme displaying code and tables in OpenCode'
			width='2840'
			height='1640'
		/>
		<div class='p-5 md:p-7'>
			<div class='flex flex-wrap items-center justify-between gap-3'>
				<h2 class='text-2xl tracking-tight'>Zinn theme</h2>
				<Chip>OpenCode</Chip>
			</div>
			<p class='mt-3 text-base leading-relaxed'>
				{opencodeTheme.introduction}
			</p>
			<span class='mt-5 inline-flex min-h-11 items-center gap-2 font-mono text-xs group-hover:underline'
				>View theme <Icon name='arrow-right' /></span
			>
		</div>
	</a>
	<a
		class='group mt-7 block max-w-3xl border border-pewter p-5 no-underline hover:no-underline md:p-7'
		href={opencodeInspector.path}>
		<div class='flex flex-wrap items-center justify-between gap-3'>
			<h2 class='text-2xl tracking-tight'>{opencodeInspector.title}</h2>
			<Chip>OpenCode</Chip>
		</div>
		<p class='mt-3 text-base leading-relaxed'>{opencodeInspector.description}</p>
		<span class='mt-5 inline-flex min-h-11 items-center gap-2 font-mono text-xs group-hover:underline'
			>View inspector <Icon name='arrow-right' /></span
		>
	</a>
	<a
		class='group mt-7 block max-w-3xl border border-pewter p-5 no-underline hover:no-underline md:p-7'
		href='/integrations/codex'>
		<div class='flex flex-wrap items-center justify-between gap-3'>
			<h2 class='text-2xl tracking-tight'>Zinn for Codex</h2>
			<Chip>Codex</Chip>
		</div>
		<p class='mt-3 text-base leading-relaxed'>
			Local task inspection and optional execution-identity hooks alongside a Codex desktop chat.
		</p>
		<span class='mt-5 inline-flex min-h-11 items-center gap-2 font-mono text-xs group-hover:underline'
			>View setup <Icon name='arrow-right' /></span
		>
	</a>
</PageLayout>
