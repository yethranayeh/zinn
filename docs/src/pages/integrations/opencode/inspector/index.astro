---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Button from "../../../../components/ui/button/Button.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import Chip from "../../../../components/ui/chip/Chip.astro";
import Icon from "../../../../components/ui/icon/Icon.astro";
import InspectorCollage from "../../../../components/InspectorCollage.astro";
import InspectorContent from "../../../../components/inspector/InspectorContent.astro";
import InlineText from "../../../../components/inspector/InlineText.astro";
import MarkdownH1 from "../../../../components/MarkdownH1.astro";
import Prose from "../../../../components/Prose.astro";

import { inspectorIntroduction, inspectorSections } from "../../../../components/inspector/content";
import { hostLogos } from "../../../../config/integrations";
import { inspectorCollage, opencodeInspector } from "../../../../config/opencode-inspector";
import { projectLinks } from "../../../../config/site";

const source = `${projectLinks.github}/tree/main/integrations/opencode/inspector`;
---

<BaseLayout title='OpenCode task inspector' description={opencodeInspector.description}>
	<div class='site-container py-8 md:py-12'>
		<Breadcrumbs />

		<section class='pb-9 md:pb-12'>
			<MarkdownH1>{opencodeInspector.title}</MarkdownH1>
			<div class='grid gap-7 md:grid-cols-[1.1fr_1fr] md:items-end md:gap-12'>
				<div>
					<Chip image={hostLogos.OpenCode}>OpenCode</Chip>
					<p class='max-w-md text-lg leading-relaxed'>{opencodeInspector.description}</p>
				</div>
				<div class='flex flex-wrap gap-3 md:justify-end'>
					<Button href='#installation' variant='solid' size='large'>Installation</Button>
					<Button href={source} variant='outline' size='large'>Source</Button>
				</div>
			</div>
		</section>

		<InspectorCollage
			base={inspectorCollage.base}
			width={inspectorCollage.width}
			height={inspectorCollage.height}
			caption={inspectorCollage.caption}
			parts={inspectorCollage.parts}
			class='mb-12 md:mb-16'
		/>

		<div class='max-w-3xl'>
			<Prose>
				<p><InlineText text={inspectorIntroduction} /></p>
			</Prose>
		</div>

		<InspectorContent sections={inspectorSections} />

		<div class='max-w-3xl'>
			<div class='mt-12 flex flex-wrap items-center justify-between gap-5 border-t border-pewter pt-6'>
				<p class='font-mono text-xs'>Verified with OpenCode {opencodeInspector.verifiedVersion}</p>
				<a class='inline-flex min-h-11 items-center gap-2 font-mono text-xs' href={source}
					>Inspector source <Icon name='external-link' /></a
				>
			</div>
		</div>
	</div>
</BaseLayout>
