---
import BaseLayout from "../layouts/BaseLayout.astro";
import Billing from "../components/pricing/Billing.astro";
import Story from "../components/pricing/Story.astro";
import Calculator from "../components/pricing/Calculator.astro";
import RunningCosts from "../components/pricing/RunningCosts.astro";
import ComparePlans from "../components/pricing/ComparePlans.astro";
import UsageMeter from "../components/pricing/UsageMeter.astro";
import Questions from "../components/pricing/Questions.astro";
import Enterprise from "../components/pricing/Enterprise.astro";
import MeterChip from "../components/pricing/MeterChip.astro";

import { pricingCommands, pricingEnvironment, pricingPackages, pricingTotals, sizeLabel } from "../config/pricing";
import { calculatorStops, cliIntegrity, measurementNote, netShare, storySteps } from "../components/pricing/figures";

const figures = {
	packages: pricingPackages.map(({ download, zinn }) => ({ download, zinn })),
	gross: pricingTotals.download,
	net: pricingTotals.softwareDownload,
	netShare,
	stops: calculatorStops,
	story: storySteps,
	commands: pricingCommands
};
---

<BaseLayout
	title='Pricing'
	description='Zinn is free of charge and MIT licensed. Its measured package download, storage and command resource use.'
	socialImage='/social/pricing.png'
	socialImageAlt={`Zinn pricing: ${sizeLabel(pricingTotals.download)} gross package download. One plan. Priced in bytes. zinn.sh/pricing.`}>
	<div class='site-container flex-1 max-w-(--site-content-width) pt-10 pb-24' data-figures={JSON.stringify(figures)}>
		<Billing />
		<Story />
		<Calculator />
		<RunningCosts />
		<ComparePlans />
		<UsageMeter />
		<Questions />
		<Enterprise />

		<p class='mt-16 max-w-176 font-mono text-[12px]/[1.6] text-muted-foreground'>{measurementNote}</p>
		<p class='grid gap-1 mt-2 max-w-176 font-mono text-[12px]/[1.6] text-muted-foreground wrap-anywhere'>
			<span>CLI {pricingEnvironment.cli} checksum {cliIntegrity}</span>
			<code>npm view @zinn-dev/cli@{pricingEnvironment.cli} dist.integrity</code>
		</p>
	</div>

	<MeterChip />
</BaseLayout>
