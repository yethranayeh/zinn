---
import BaseLayout from "../layouts/BaseLayout.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
	title='Zinn — A kanban workflow in the terminal'
	description='Zinn is an experimental command-line kanban tool. Manage projects and tasks locally in your terminal. Requires Bun.'>
	<main class='flex min-h-svh flex-col px-6 pt-8 pb-6 md:px-12 md:pt-10 md:pb-8 lg:px-24'>
		<header>
			<h1 class='text-xl font-semibold tracking-tight'>Z<span class='text-bronze'>I</span>NN</h1>
		</header>
		<div class='my-auto w-full max-w-3xl pt-16 pb-14 md:pt-24 md:pb-16 2xl:ml-32'>
			<p class='mb-9 max-w-xl text-4xl leading-tight tracking-tight md:mb-12 md:text-5xl'>
				A kanban workflow<br />in the <mark class='box-decoration-clone bg-bronze px-1 pb-0.5 text-soot'>terminal.</mark
				>
			</p>
			<InstallCommand />
			<nav class='mt-10 flex items-center gap-7 font-mono text-xs leading-normal' aria-label='Zinn links'>
				<a
					class='inline-flex items-center gap-2 py-2'
					href='https://github.com/yethranayeh/zinn'
					data-site-event='github-click'>GitHub <Icon name='external-link' class='size-4.5 text-bone' /></a
				>
				<a
					class='inline-flex items-center gap-2 py-2'
					href='https://www.npmjs.com/package/@zinn-dev/cli'
					data-site-event='npm-click'>npm <Icon name='external-link' class='size-4.5 text-bone' /></a
				>
			</nav>
		</div>
		<footer class='mt-auto'><span class='font-mono text-xs tracking-widest'>zinn.sh</span></footer>
	</main>
</BaseLayout>

<script>
	import { trackEvent } from "../scripts/analytics";

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-site-event]")) {
		link.addEventListener("click", () => {
			const event = link.dataset.siteEvent;
			if (event === "github-click" || event === "npm-click") {
				trackEvent(event);
			}
		});
	}
</script>
