---
import PageLayout from "../layouts/PageLayout.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Icon from "../components/Icon.astro";

import { projectLinks } from "../config/site";
---

<PageLayout
	title='Zinn | A kanban workflow in the terminal'
	description='Zinn is an experimental command-line kanban tool. Manage projects and tasks locally in your terminal. Requires Bun.'
	linkHome={false}>
	<h1 class='mb-9 max-w-xl text-3xl leading-tight tracking-tight sm:text-4xl md:mb-12 md:text-5xl'>
		A kanban workflow<br />in the <span class='text-cinnabar'>terminal</span>.
	</h1>
	<InstallCommand />
	<nav class='mt-6 flex items-center gap-7 font-mono text-xs leading-normal' aria-label='Zinn links'>
		<a
			class='inline-flex items-center gap-2 py-2'
			href={projectLinks.github}
			aria-label='Zinn source on GitHub'
			data-site-event='github-click'>GitHub <Icon name='external-link' class='size-4.5' /></a
		>
		<a
			class='inline-flex items-center gap-2 py-2'
			href={projectLinks.npm}
			aria-label='Zinn CLI package on npm'
			data-site-event='npm-click'>npm <Icon name='external-link' class='size-4.5' /></a
		>
	</nav>
</PageLayout>

<script>
	import { trackEvent } from "../scripts/analytics";

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-site-event]")) {
		link.addEventListener("click", () => {
			const event = link.dataset.siteEvent;
			if (event === "github-click" || event === "npm-click") {
				trackEvent(event);
			}
		});
	}
</script>
