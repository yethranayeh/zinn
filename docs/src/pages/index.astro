---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/Prose.astro";
import AgentSetup from "../components/AgentSetup.astro";
import InstallCommand from "../components/InstallCommand.astro";
import ReadingSection from "../components/ReadingSection.astro";
import TerminalCommands from "../components/TerminalCommands.astro";
import ScrollCue from "../components/ScrollCue.astro";
import Icon from "../components/ui/icon/Icon.astro";

import { homepage, projectLinks } from "../config/site";

const documentation = "/docs/cli";
const workflowCommands = [
	"zinn project create DEMO --name 'Release work'",
	"zinn task create DEMO \\\n  --title 'Write release notes' \\\n  --priority high",
	"zinn task move DEMO-1 'In Progress'",
	"zinn task list DEMO --json"
];
---

<BaseLayout title='Zinn' fullTitle={homepage.title} description={homepage.description}>
	<section
		class='site-container flex min-h-[calc(100svh_-_var(--site-header-height))] flex-col pb-6 md:pb-8'
		aria-label='Install Zinn'>
		<div class='my-auto w-full max-w-3xl pt-10 pb-14 md:pt-14 md:pb-16'>
			<h1 class='max-w-xl text-4xl leading-tighter tracking-tight md:text-5xl'>
				A kanban workflow<br />in the <span class='text-cinnabar'>terminal</span>.
			</h1>

			<InstallCommand />

			<div class='flex flex-wrap justify-between w-full'>
				<nav
					class='flex flex-col md:flex-row items-start md:items-center gap-1 md:gap-4 pt-2 font-mono text-xs leading-normal'
					aria-label='Zinn links'>
					<a
						class='inline-flex items-center gap-1'
						href={projectLinks.github}
						aria-label='Zinn source on GitHub'
						data-site-event='github-click'>GitHub <Icon name='external-link' class='size-[1.5cap]' /></a
					>
					<a
						class='inline-flex items-center gap-1'
						href={projectLinks.npm}
						aria-label='Zinn CLI package on npm'
						data-site-event='npm-click'>npm <Icon name='external-link' class='size-[1.5cap]' /></a
					>
				</nav>

				<AgentSetup />
			</div>
		</div>

		<ScrollCue href='#definition-heading' />
	</section>

	<ReadingSection id='what-is-zinn' labelledBy='definition-heading' first decorated>
		<Prose>
			<h2 id='definition-heading' tabindex='-1' class='pr-16 md:pr-24'>Zinn: a kanban CLI for your terminal</h2>
			<p class='lead'>
				Zinn is an Experimental task manager for you <span class='block'>and the agents you work with.</span>
			</p>
			<p>
				Each project is a board of columns and tasks. You and your agents create, move and comment on the same tasks
				with the same commands, and all of it lives in one SQLite database on your machine.
			</p>
		</Prose>
	</ReadingSection>

	<ReadingSection labelledBy='workflow-heading' surface='bone' split>
		<Prose>
			<h2 id='workflow-heading'>Start a project. Move the work.</h2>
			<p>
				Create a project, add a task, then move it into In Progress. <span class='block'
					>Each project begins with Backlog, TODO, In Progress, Review and Done columns, which you can rename or extend.</span
				>
			</p>
			<p>
				Descriptions hold the scope and comments the updates. Labels and priorities organize the work, and related,
				dependency, duplicate and subtask relations connect it. Search covers titles, descriptions and comments, and
				archiving hides finished tasks from active lists.
			</p>
		</Prose>
		<Prose>
			<TerminalCommands
				class='workflow-sequence'
				label='Project workflow commands, horizontally scrollable'
				commands={workflowCommands}
			/>
			<p>
				Give a task a deadline with <code>--due</code>, then sort by it with <code>task list --sort due</code> or select a
				range with <code>--due-since</code> and <code>--due-until</code>. <code>task move</code>, <code
					>task archive</code
				> and <code>task delete</code> take several tasks at once. <code>--description-file</code> and <code
					>--text-file</code
				> read text from a file or stdin, and <code>--limit</code> with <code>--starting-after</code> continues a long list.
			</p>
		</Prose>
	</ReadingSection>

	<ReadingSection labelledBy='agents-heading' surface='limestone'>
		<Prose>
			<h2 id='agents-heading'>Work alongside your agents</h2>
			<p class='lead'>
				Zinn doesn't stop at who changed a task. It takes you back into the conversation that made the change.
			</p>
			<p>
				<a href='/docs/cli#activity'>Activity</a> records the agent and session behind a change, and <code
					>zinn activity list --task &lt;task-key&gt;</code
				> lists the changes to a task. Claude Code and Codex sessions are recorded without setup.
			</p>
			<p>
				The Zinn workflow skill teaches an agent to find its task, keep context in comments, record follow-ups and hand
				off at the project's review column. <a href='/docs/installation#use-with-coding-agents'
					>Set it up for your agent</a
				>.
			</p>
			<p>
				For scripts, <code>--json</code> prints one JSON document on <strong>stdout</strong>. A failure exits with code
				{" "}<code>1</code> and writes a JSON error to <strong>stderr</strong>, so scripts can match its code. <code
					>zinn capabilities --json</code
				> describes every command's inputs, effects and result schemas, and <code>--yes</code> confirms prompts. Read <a
					href='/docs/scripting'>scripting and JSON output</a
				> for the details.
			</p>
		</Prose>
	</ReadingSection>

	<ReadingSection labelledBy='storage-heading' surface='bone'>
		<Prose>
			<h2 id='storage-heading'>Keep the work local</h2>
			<p>
				Every project lives in one SQLite database, <code>~/.zinn/data/zinn.sqlite</code> by default. Keep it elsewhere with{
					" "
				}
				<a href='/docs/settings'>settings</a>.
			</p>
			<p>
				<code>zinn backup</code> saves a database snapshot, and <code>zinn restore</code> puts one back after saving the current
				database. A newer release upgrades an older database after making a backup. Read <a href='/docs/data'
					>data and backups</a
				> for the details.
			</p>
		</Prose>
	</ReadingSection>

	<ReadingSection labelledBy='next-heading' surface='limestone'>
		<Prose>
			<h2 id='next-heading'>Take the next command</h2>
			<p>
				Zinn is free and MIT licensed. See its <a href='/pricing'>price in bytes and running costs</a>.
			</p>
			<p>
				Read the <a href='/docs/quick-start'>quick start</a> or <a href={`${documentation}#start-a-project`}
					>project reference</a
				>, browse the <a href={projectLinks.github} data-site-event='github-click'>Zinn source on GitHub</a> or find the <a
					href={projectLinks.npm}
					data-site-event='npm-click'>Zinn CLI package on npm</a
				>.
			</p>
		</Prose>
	</ReadingSection>

	<nav slot='footer' class='flex gap-5 sm:ml-auto' aria-label='Zinn social profiles'>
		<a href={projectLinks.twitter} data-site-event='twitter-click'>Twitter</a>
		<a href={projectLinks.bluesky} data-site-event='bluesky-click'>Bluesky</a>
	</nav>
</BaseLayout>

<script>
	import { trackEvent } from "../scripts/analytics";

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-site-event]")) {
		link.addEventListener("click", () => {
			const event = link.dataset.siteEvent;
			if (event === "github-click" || event === "npm-click" || event === "twitter-click" || event === "bluesky-click") {
				trackEvent(event);
			}
		});
	}
</script>

<style is:global>
	@supports (animation-timeline: view()) and (view-timeline-name: --workflow-sequence) {
		@media (prefers-reduced-motion: no-preference) {
			.workflow-sequence {
				view-timeline-name: --workflow-sequence;
			}

			.workflow-sequence [data-terminal-command] {
				--workflow-range: cover 0% cover 0%;
				color: color-mix(in srgb, var(--color-bone) 70%, var(--color-soot));
				animation: workflow-command-emphasis linear;
				animation-timeline: --workflow-sequence;
				animation-range: var(--workflow-range);
			}

			.workflow-sequence [data-terminal-prompt] {
				opacity: 0;
				animation: workflow-command-prompt linear;
				animation-timeline: --workflow-sequence;
				animation-range: var(--workflow-range);
			}

			.workflow-sequence [data-terminal-command]:nth-of-type(1) {
				--workflow-range: cover 0% cover 45%;
			}

			.workflow-sequence [data-terminal-command]:nth-of-type(2) {
				--workflow-range: cover 45% cover 65%;
			}

			.workflow-sequence [data-terminal-command]:nth-of-type(3) {
				--workflow-range: cover 65% cover 80%;
			}

			.workflow-sequence [data-terminal-command]:nth-of-type(4) {
				--workflow-range: cover 80% cover 100%;
			}
		}
	}

	@keyframes workflow-command-emphasis {
		from,
		to {
			color: var(--color-limestone);
		}
	}

	@keyframes workflow-command-prompt {
		from,
		to {
			opacity: 1;
		}
	}
</style>
