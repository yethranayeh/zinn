---
import BaseLayout from "../layouts/BaseLayout.astro";
import Branding from "../components/Branding.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Icon from "../components/Icon.astro";
import ReadingSection from "../components/ReadingSection.astro";
import Prose from "../components/Prose.astro";
import TerminalCommands from "../components/TerminalCommands.astro";
import ScrollCue from "../components/ScrollCue.astro";

import { homepage, projectLinks } from "../config/site";

const documentation = `${projectLinks.github}/blob/main/packages/cli/README.md`;
const workflowCommands = [
	'zinn project create DEMO --name "Release work"',
	'zinn task create DEMO \\\n  --title "Write release notes" \\\n  --priority high',
	'zinn task move DEMO-1 "In Progress"',
	"zinn task list DEMO --json"
];
---

<BaseLayout title={homepage.title} description={homepage.description}>
	<main>
		<section
			class='flex min-h-dvh flex-col px-6 pt-8 pb-6 md:px-12 md:pt-10 md:pb-8 lg:px-24'
			aria-label='Install Zinn'>
			<header><Branding /></header>

			<div class='space-y-6 md:space-y-4 my-auto w-full max-w-3xl pt-16 pb-14 md:pt-24 md:pb-16 2xl:ml-32'>
				<h1 class='max-w-xl text-4xl leading-tight tracking-tight md:text-5xl'>
					A kanban workflow<br />in the <span class='text-cinnabar'>terminal</span>.
				</h1>
				<InstallCommand />
				<nav class='flex items-center gap-7 font-mono text-xs leading-normal' aria-label='Zinn links'>
					<a
						class='inline-flex items-center gap-2 py-2'
						href={projectLinks.github}
						aria-label='Zinn source on GitHub'
						data-site-event='github-click'>GitHub <Icon name='external-link' class='size-4.5' /></a
					>
					<a
						class='inline-flex items-center gap-2 py-2'
						href={projectLinks.npm}
						aria-label='Zinn CLI package on npm'
						data-site-event='npm-click'>npm <Icon name='external-link' class='size-4.5' /></a
					>
				</nav>
			</div>

			<ScrollCue href='#definition-heading' />
		</section>
		<ReadingSection id='what-is-zinn' labelledBy='definition-heading' first decorated>
			<Prose>
				<h2 id='definition-heading' tabindex='-1' class='scroll-mt-6 pr-16 md:pr-24'>A board in your terminal</h2>
				<p class='lead'>Zinn is an Experimental kanban task manager for the terminal.</p>
				<p>
					Organize work into projects, columns and tasks. Manage it from the command line, with descriptions,
					priorities, labels and comments to keep the detail close. Projects and tasks are stored in a local SQLite
					database.
				</p>
				<p>
					For developers who already work in the terminal, the board is another command away. Scripts and agents can
					read and write tasks using the CLI's JSON output.
				</p>
			</Prose>
		</ReadingSection>
		<ReadingSection labelledBy='workflow-heading' surface='bone' split>
			<Prose>
				<h2 id='workflow-heading'>Start a project. Move the work.</h2>
				<p>
					Create a project, add a task, then move it into In Progress. Each project begins with Backlog, TODO, In
					Progress, Review and Done columns, which you can rename or extend.
				</p>
				<p>
					Use descriptions for scope, comments for updates and labels and priorities to organize tasks. Connect work
					with related, dependency, duplicate and subtask relations. Search titles, descriptions and comments, and
					archive tasks when they no longer belong in the active list.
				</p>
			</Prose>
			<Prose>
				<TerminalCommands label='Project workflow commands, horizontally scrollable' commands={workflowCommands} />
				<p>
					Add <code>--json</code> to any command for a single JSON document on stdout. Use <code>--yes</code> to skip confirmation
					prompts in scripts and agent workflows.
				</p>
			</Prose>
		</ReadingSection>
		<ReadingSection labelledBy='storage-heading' surface='limestone'>
			<Prose>
				<h2 id='storage-heading'>Keep the work local</h2>
				<p>
					The default database is <code>~/.zinn/data/zinn.sqlite</code>. Set <code>ZINN_DIR</code> to use another directory,
					keeping the same value across commands.
				</p>
				<p>
					<code>zinn backup</code> saves a database snapshot. Zinn does not upgrade existing databases between releases; back
					up before upgrading.
				</p>
				<p><a href={`${documentation}#back-up-the-database`}>Read the database backup instructions</a>.</p>
			</Prose>
		</ReadingSection>
		<ReadingSection labelledBy='next-heading' surface='bone'>
			<Prose>
				<h2 id='next-heading'>Take the next command</h2>
				<p>
					Read the <a href={`${documentation}#start-a-project`}>first-project guide</a>, browse the <a
						href={projectLinks.github}
						data-site-event='github-click'>Zinn source on GitHub</a
					> or find the <a href={projectLinks.npm} data-site-event='npm-click'>Zinn CLI package on npm</a>.
				</p>
			</Prose>
		</ReadingSection>
	</main>
	<footer
		class='flex flex-wrap items-end justify-between gap-4 border-t-[3px] border-soot px-6 py-6 font-mono text-xs md:px-12 md:py-8 lg:px-24'>
		<span class='tracking-widest'>zinn.sh</span>
		<nav class='ml-auto flex gap-5' aria-label='Zinn social profiles'>
			<a href={projectLinks.twitter} data-site-event='twitter-click'>Twitter</a>
			<a href={projectLinks.bluesky} data-site-event='bluesky-click'>Bluesky</a>
		</nav>
	</footer>
</BaseLayout>

<script>
	import { trackEvent } from "../scripts/analytics";

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-site-event]")) {
		link.addEventListener("click", () => {
			const event = link.dataset.siteEvent;
			if (event === "github-click" || event === "npm-click" || event === "twitter-click" || event === "bluesky-click") {
				trackEvent(event);
			}
		});
	}
</script>
