---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout
	title='Page not found | Zinn'
	description='This page could not be found. Return to the Zinn homepage.'
	noindex>
	<p class='mb-6 font-mono text-xs'>404</p>
	<h1 class='mb-6 text-3xl leading-tight tracking-tight sm:text-4xl md:text-5xl'>Page not found.</h1>
	<p class='mb-9 max-w-xl'>There is nothing else to see, <span class='text-cinnabar'>yet</span>.</p>
	<a class='inline-block py-2 font-mono text-sm underline' href='/'>Return to the homepage</a>
	<p class='mt-9 text-xs leading-normal'>Experimental.</p>
</PageLayout>
