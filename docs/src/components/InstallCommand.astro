---
import CopyButton from "./CopyButton.astro";
import AccentTerminalText from "./AccentTerminalText.astro";
import { installCommand as command } from "../config/site";
---

<div class='group/install' data-install>
	<div
		class='relative bg-soot px-3 md:px-4 py-4 md:py-5 text-soot-foreground scheme-dark selection:bg-limestone! selection:text-soot! md:px-5'>
		<div class='md:pr-14'>
			<div class='space-y-2 text-sm leading-relaxed whitespace-nowrap md:text-xl'>
				<code class='block group-data-copied/install:text-soot-muted-foreground'
					><span
						class='mr-1.5 inline-block w-[2ch] text-bronze select-none group-data-copied/install:invisible md:mr-2.5'
						aria-hidden='true'>$</span
					><AccentTerminalText text={command} command='install' /></code
				>
				<code class='block text-soot-muted-foreground group-data-copied/install:text-soot-foreground'
					><span
						class='invisible mr-1.5 inline-block w-[2ch] text-bronze select-none group-data-copied/install:visible md:mr-2.5'
						aria-hidden='true'>&gt;_</span
					><AccentTerminalText text='zinn --help' command='help' /></code
				>
			</div>
		</div>

		<CopyButton
			class='absolute right-0 bottom-0 w-fit md:top-5 md:right-5 md:bottom-auto'
			variant='ghost-inverted'
			size='responsive-icon'
			value={command}
			label='COPY'
			aria-label='Copy installation command'
			title='Copy command'
			success='Installation command copied to clipboard. After installing, run zinn --help.'
			event='install-copy'
			stateTarget='[data-install]'
		/>
	</div>
</div>

<style>
	:global([data-install] [data-accent-command="help"]),
	:global([data-install][data-copied] [data-accent-command="install"]) {
		--accent-display: none;
		--accent-ink: currentColor;
	}

	:global([data-install][data-copied] [data-accent-command="help"]) {
		--accent-display: block;
		--accent-ink: transparent;
	}
</style>
