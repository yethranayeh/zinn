---
import PricingLabel from "./PricingLabel.astro";
import PricingTitle from "./PricingTitle.astro";

interface Props {
	id: string;
	label: string;
	title?: string;
}

const { id, label, title } = Astro.props;
---

<section
	class='grid grid-cols-1 max-w-[76rem] mt-16 border-t border-soot/20 pt-6 gap-6 lg:gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]'
	aria-labelledby={id}>
	<div>
		<PricingLabel as='h2' id={id}>{label}</PricingLabel>
		{title && <PricingTitle>{title}</PricingTitle>}
	</div>
	<slot />
</section>
