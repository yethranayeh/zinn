---
import Section from "./Section.astro";
import PricingNote from "./PricingNote.astro";
import MeterModule from "./MeterModule.astro";
import MeterFigure from "./MeterFigure.astro";
import MeterStrip from "./MeterStrip.astro";
import MeterKindRow from "./MeterKindRow.astro";
import MeterValue from "./MeterValue.astro";

const kinds = [
	{ kind: "document", label: "Document" },
	{ kind: "scripts", label: "Scripts" },
	{ kind: "styles", label: "Styles" },
	{ kind: "fonts", label: "Fonts" },
	{ kind: "images", label: "Images" },
	{ kind: "other", label: "Other" }
];
---

<Section id='zp-meter' label='Usage to date' title="This page isn't free either.">
	<div class='@container min-w-0 font-mono leading-[1.4] text-soot tabular-nums' data-meter>
		<div class='border border-soot/25 bg-bone'>
			<div
				class='flex flex-wrap items-center justify-between gap-x-4.5 gap-y-1 border-b border-soot/22 px-3.5 py-2.25 text-[9.5px]/[1.4] tracking-[0.14em] text-muted-foreground uppercase'>
				<span class='flex items-center gap-1.75 text-soot'>
					<i class='block size-1.5 bg-soot'></i>Usage to date · live
				</span>
				<span>1 s tick · read in the browser</span>
			</div>
			<div class='grid grid-cols-3 gap-px bg-soot/18 @max-[640px]:grid-cols-1'>
				<MeterModule class='col-span-2 @max-[640px]:col-span-1' label='Transferred' data-module>
					<Fragment slot='meta'><MeterValue field='requests'>0</MeterValue> requests</Fragment>
					<MeterFigure>
						<span data-f='total'>0 B</span>
						<Fragment slot='sub'>
							from cache <MeterValue field='cached'>0 B</MeterValue> at full size · unpacked <MeterValue field='decoded'
								>0 B</MeterValue
							>
						</Fragment>
					</MeterFigure>
					<MeterStrip strip='bytes' />
				</MeterModule>

				<MeterModule label='By kind' meta='bytes' data-module>
					<ul class='mt-2.75 grid gap-1.5'>
						{kinds.map((entry) => <MeterKindRow label={entry.label} kind={entry.kind} />)}
					</ul>
					<div class='mt-2.25 text-[10.5px]/[1.45] text-muted-foreground'>
						sum <MeterValue field='kind-sum'>0 B</MeterValue>
					</div>
				</MeterModule>

				<MeterModule label='Canvas work' meta='frames' data-module>
					<MeterFigure>
						<span data-f='canvas'>0</span>
						<Fragment slot='sub'>
							elements <MeterValue field='elements'>0</MeterValue> · canvases <MeterValue field='canvases'>0</MeterValue
							> · frames drawn on this page
						</Fragment>
					</MeterFigure>
					<MeterStrip strip='canvas' />
				</MeterModule>

				<MeterModule
					class='col-span-2 @max-[640px]:col-span-1'
					label='Time on this page'
					meta='open / visible'
					data-module>
					<MeterFigure>
						<span data-f='open'>00:00</span><span class='text-[0.62em] text-muted-foreground'>
							/ <span data-f='visible'>00:00</span></span
						>
						<Fragment slot='sub'>visible counts only while the tab is in front</Fragment>
					</MeterFigure>
				</MeterModule>

				<MeterModule
					class='col-span-full @min-[640px]:[&:has(+[data-memory])]:col-span-1'
					label='Main thread'
					meta='blocked'
					data-module
					data-paint>
					<MeterFigure subClass='flex flex-wrap items-center gap-x-2 gap-y-0.5'>
						<span data-paint-big>0 ms</span>
						<Fragment slot='sub'>
							<span data-paint-option='lcp'>LCP <MeterValue field='lcp'>reading</MeterValue></span>
							<span data-paint-separator aria-hidden='true'>·</span>
							<span data-paint-option='cls'>CLS <MeterValue field='cls'>reading</MeterValue></span>
						</Fragment>
					</MeterFigure>
				</MeterModule>

				<MeterModule
					class='col-span-full @min-[640px]:[[data-paint]+&]:col-span-2'
					label='Memory'
					meta='browser reading'
					data-module
					data-memory>
					<MeterFigure subClass='flex flex-wrap items-center gap-x-2 gap-y-0.5'>
						<span data-f='heap'>reading</span>
						<Fragment slot='sub'>
							<span data-option='cpu' hidden>CPU <MeterValue field='cpu'>reading</MeterValue></span>
							<span data-separator aria-hidden='true' hidden>·</span>
							<span data-option='connection' hidden>Connection <MeterValue field='connection'>reading</MeterValue></span
							>
						</Fragment>
					</MeterFigure>
					<MeterStrip strip='heap' />
				</MeterModule>

				<MeterModule class='col-span-full' label='Requests' meta='waterfall' data-module>
					<div class='mt-2'>
						<div class='flex justify-between text-[9px] tracking-[0.12em] text-muted-foreground uppercase'>
							<span>0 ms</span><span data-trace-end>0 ms</span>
						</div>
						<ol class='mt-1.5 border-t border-soot/[0.14]' data-rows></ol>
						<p class='mt-2 text-[10px] text-muted-foreground' data-more hidden></p>
					</div>
				</MeterModule>
			</div>
		</div>
	</div>
	<PricingNote
		>Read from your browser, on your machine, and sent nowhere. Includes only what this page has loaded.</PricingNote
	>
</Section>

<script>
	import { mountMonitor } from "./meter-view";

	const root = document.querySelector<HTMLElement>("[data-meter]");
	if (root) {
		mountMonitor(root);
	}
</script>
