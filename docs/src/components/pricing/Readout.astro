---
import PricingLabel from "./PricingLabel.astro";

interface Props {
	label: string;
	[key: string]: unknown;
}

const { label, ...attributes } = Astro.props;
---

<div>
	<PricingLabel as='dt'>{label}</PricingLabel><dd
		class='mt-1.5 min-h-[1em] font-mono text-[clamp(1.25rem,3vw,2rem)] leading-none tracking-[-0.02em] tabular-nums whitespace-nowrap'
		{...attributes}>
		<slot />
	</dd>
</div>
