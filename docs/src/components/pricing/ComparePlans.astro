---
import Table from "../ui/table/Table.astro";
import TableCell from "../ui/table/TableCell.astro";
import TableHead from "../ui/table/TableHead.astro";
import TableRow from "../ui/table/TableRow.astro";
import Section from "./Section.astro";

import { comparison } from "./figures";
---

<Section id='zp-compare' label='Compare plans' title='All one of them.'>
	<div class='relative max-w-[38rem]'>
		<Table
			class='bg-transparent [&_th]:border-b-0 [&_th]:bg-soot [&_th]:px-5 [&_th]:py-2.5 [&_th]:text-[0.8125rem] [&_th]:tracking-[0.02em] [&_th]:normal-case [&_th]:not-first:border-l-0 [&_td]:border-b-soot/14 [&_td]:px-5 [&_td]:py-3.5 [&_td]:wrap-break-word [&_td]:not-first:border-l-0 [&_tr]:even:bg-[color-mix(in_srgb,var(--color-bone)_40%,transparent)] [&_tr:last-child>td]:border-b-soot'>
			<thead>
				<TableRow>
					<TableHead><span class='sr-only'>Feature</span></TableHead>
					<TableHead>
						<span class='text-lg mr-4'>Zinn</span>
						<span
							class='w-fit px-1.5 py-0.5 bg-bronze text-soot font-mono text-xs font-normal tracking-widest uppercase'
							>Most popular</span
						>
					</TableHead>
				</TableRow>
			</thead>
			<tbody>
				{
					comparison.map(([feature, value]) => (
						<TableRow>
							<TableCell>{feature}</TableCell>
							<TableCell>{value}</TableCell>
						</TableRow>
					))
				}
			</tbody>
		</Table>
	</div>
</Section>
