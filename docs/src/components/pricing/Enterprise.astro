---
import PricingTitle from "./PricingTitle.astro";
import PricingBody from "./PricingBody.astro";
import PricingAction from "./PricingAction.astro";
---

<section
	class='grid max-w-304 mt-16 border-t border-soot/20 pt-6 gap-2 justify-items-start lg:gap-10 lg:grid-cols-[16rem_minmax(0,1fr)_auto] lg:items-baseline'
	aria-labelledby='zp-sales'>
	<PricingTitle as='h2' id='zp-sales' class='lg:mt-0'>Enterprise</PricingTitle>
	<PricingBody class='lg:mt-0'>Same plan. Same bytes.</PricingBody>
	<PricingAction class='mt-3 lg:mt-0' href='/contact'>Contact sales</PricingAction>
</section>
