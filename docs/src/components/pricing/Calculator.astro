---
import Section from "./Section.astro";
import PricingNote from "./PricingNote.astro";
import Readouts from "./Readouts.astro";
import Readout from "./Readout.astro";
import TextureSlider from "../ui/texture-slider/TextureSlider.astro";

import { groupedNumber, memoryLabel, outputLabel, sizeLabel } from "../../config/pricing-labels";
import { calculatorStops, defaultStop, markedStops, storageNote } from "./figures";
import { lastPosition, positionOf } from "./calculator-scale";

const stop = calculatorStops[defaultStop];
---

<Section id='zp-calc' label='Usage calculator' title='What a project of your size costs.'>
	<div class='@container grid gap-8' data-calc>
		<div>
			<div class='flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2'>
				<label for='zp-tasks' class='text-[1rem]'>Tasks, each with one comment</label>
				<output
					for='zp-tasks'
					class='ml-auto min-w-[6ch] text-right font-mono text-[1.25rem] leading-none tabular-nums'
					data-calc-tasks>{groupedNumber(stop.tasks)}</output
				>
			</div>
			<TextureSlider
				texture='rules'
				id='zp-tasks'
				min='0'
				max={lastPosition}
				step='1'
				value={positionOf(stop.tasks)}
				aria-valuetext={`${groupedNumber(stop.tasks)} tasks`}
				class='mt-3'
			/>

			<div class='relative h-[1.4em] font-mono text-[11px]/[1.4] text-muted-foreground'>
				{
					calculatorStops
						.filter((entry) => markedStops.includes(entry.tasks))
						.map((entry) => {
							const position = positionOf(entry.tasks);

							return (
								<button
									type='button'
									class='absolute top-0 -my-2 py-2 -translate-x-1/2 first:translate-x-0 last:-translate-x-full hover:text-soot'
									style={`left: ${(position / lastPosition) * 100}%`}
									data-calc-mark={position}
									aria-label={`Set to ${groupedNumber(entry.tasks)} tasks`}>
									{groupedNumber(entry.tasks)}
								</button>
							);
						})
				}
			</div>
			<PricingNote>Marks are measured. Figures between them are interpolated. {storageNote}</PricingNote>
		</div>

		<Readouts class='grid-cols-2 @lg:grid-cols-3 @2xl:grid-cols-5 [&_dd]:text-[clamp(1.25rem,3cqw,2rem)]'>
			<Readout label='Database' data-calc-out='db'>{sizeLabel(stop.databaseBytes)}</Readout>
			<Readout label='List time' data-calc-out='seconds'>{stop.seconds.toFixed(2)} s</Readout>
			<Readout label='List memory' data-calc-out='memory'>{memoryLabel(stop.memoryBytes)}</Readout>
			<Readout label='List output' data-calc-out='output'>{outputLabel(stop.outputBytes)}</Readout>
			<Readout label='As JSON' data-calc-out='json'>{outputLabel(stop.jsonOutputBytes)}</Readout>
		</Readouts>
	</div>
</Section>

<script>
	import { groupedNumber, memoryLabel, outputLabel, sizeLabel } from "../../config/pricing-labels";
	import { figures } from "./page-figures";
	import { figuresAt, tasksAt } from "./calculator-scale";

	function setupCalculator() {
		const container = document.querySelector<HTMLElement>("[data-calc]");
		const input = container?.querySelector("input");
		if (!container || !input) {
			return;
		}
		const out = (name: string) => container.querySelector<HTMLElement>(`[data-calc-out='${name}']`);
		const tasks = container.querySelector<HTMLElement>("[data-calc-tasks]");

		function update() {
			const count = tasksAt(Number(input!.value));
			const stop = figuresAt(figures.stops, count);
			const taskCount = groupedNumber(count);
			input!.setAttribute("aria-valuetext", `${taskCount} tasks`);
			const readouts: Array<[HTMLElement | null, string]> = [
				[out("db"), sizeLabel(stop.databaseBytes)],
				[out("seconds"), `${stop.seconds.toFixed(2)} s`],
				[out("memory"), memoryLabel(stop.memoryBytes)],
				[out("output"), outputLabel(stop.outputBytes)],
				[out("json"), outputLabel(stop.jsonOutputBytes)]
			];
			for (const [element, value] of readouts) {
				if (element) {
					element.textContent = value;
					element.toggleAttribute("data-approximate", !stop.exact);
				}
			}
			if (tasks) {
				tasks.textContent = taskCount;
			}
		}

		for (const mark of container.querySelectorAll<HTMLButtonElement>("[data-calc-mark]")) {
			mark.addEventListener("click", () => {
				const position = mark.dataset.calcMark;
				if (position) {
					input.value = position;
					input.dispatchEvent(new Event("input", { bubbles: true }));
				}
			});
		}

		input.addEventListener("input", update);
	}

	setupCalculator();
</script>
