---
import type { HTMLAttributes } from "astro/types";

type Variant = "ghost" | "ghost-inverted" | "solid" | "outline";
type Size = "default" | "large" | "icon" | "responsive-icon";
type ButtonProps = HTMLAttributes<"button"> & { href?: undefined };
type LinkProps = HTMLAttributes<"a"> & { href: string };

// Renders a link when given href, otherwise a button whose type defaults to "button".
type Props = (ButtonProps | LinkProps) & { variant?: Variant; size?: Size };

const { variant = "ghost", size = "default", class: className, ...attributes } = Astro.props;
const variants = {
	ghost: "text-left hover:bg-soot/8 focus-visible:outline-offset-2",
	"ghost-inverted": "text-left hover:bg-limestone/8 focus-visible:outline-offset-2",
	solid: "border border-soot bg-soot text-soot-foreground hover:bg-soot/90 focus-visible:outline-offset-4",
	outline: "border border-soot hover:bg-soot/8 focus-visible:outline-offset-4"
};
const sizes = {
	default: "min-h-11 px-2.5 py-2.5 text-xs",
	large: "min-h-11 px-4 py-3 text-sm",
	icon: "size-11 p-2.5 text-xs",
	"responsive-icon": "p-2.5 text-xs md:size-11"
};
const classes = [
	"inline-flex cursor-pointer items-center justify-center gap-2 font-mono no-underline hover:no-underline disabled:cursor-wait disabled:opacity-50",
	variants[variant],
	sizes[size],
	className
];
---

{
	attributes.href === undefined ? (
		<button class:list={classes} {...{ type: "button", ...attributes }}>
			<slot />
		</button>
	) : (
		<a class:list={classes} {...attributes}>
			<slot />
		</a>
	)
}
