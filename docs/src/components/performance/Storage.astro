---
import PricingBody from "../pricing/PricingBody.astro";
import Readout from "../pricing/Readout.astro";
import Readouts from "../pricing/Readouts.astro";
import Section from "../pricing/Section.astro";

import { size, storage } from "./flow-data";
---

<Section id='perf-storage' label='Storage' title='What the database holds.'>
	<div class='min-w-0'>
		<Readouts class='grid-cols-2 lg:grid-cols-4'>
			<Readout label='Empty database'>{size(storage.empty)}</Readout>
			<Readout label='Per task'>{size(storage.task)}</Readout>
			<Readout label='Per comment'>{size(storage.comment)}</Readout>
			<Readout label='At 10,000 tasks'>{size(storage.tenK)}</Readout>
		</Readouts>
		<PricingBody>
			An empty database is {size(storage.empty)}. A task adds about {size(storage.task)} and a comment about{" "}
			{size(storage.comment)}. At 10,000 tasks the file is {size(storage.tenK)}.
		</PricingBody>
	</div>
</Section>
