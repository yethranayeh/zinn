---
interface Props {
	label: string;
	value: string;
}

const { label, value } = Astro.props;
---

<div class='bg-limestone px-3 py-2.5'>
	<p class='m-0 font-mono text-[9px]/[1.4] tracking-[0.14em] text-muted-foreground uppercase'>{label}</p>
	<p class='mt-0.5 font-mono text-[clamp(1rem,2vw,1.25rem)] leading-none tabular-nums'>{value}</p>
</div>
