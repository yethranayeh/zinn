---
import PricingBody from "../pricing/PricingBody.astro";
import PricingNote from "../pricing/PricingNote.astro";
import Section from "../pricing/Section.astro";
import Table from "../ui/table/Table.astro";
import TableCell from "../ui/table/TableCell.astro";
import TableHead from "../ui/table/TableHead.astro";
import TableRow from "../ui/table/TableRow.astro";

import { commands, memory, output, secondsLabel } from "./flow-data";

const rows = commands.map((entry) => ({
	command: entry.command,
	p50: secondsLabel(entry.p50),
	p95: secondsLabel(entry.p95),
	memory: memory(entry.memoryBytes),
	output: output(entry.outputBytes),
	mock: entry.mock ?? false
}));
---

<Section id='perf-commands' label='Commands' title='What a command costs.'>
	<div class='min-w-0'>
		<PricingBody>
			The 100-task fixture, one comment per task. p50, peak memory and output are measured for the first four commands.
			p95 and the last three commands are placeholders.
		</PricingBody>
		<Table class='[&_td]:text-[13px]'>
			<thead>
				<TableRow>
					<TableHead>Command</TableHead>
					<TableHead>p50</TableHead>
					<TableHead>p95</TableHead>
					<TableHead>Peak memory</TableHead>
					<TableHead>Output</TableHead>
				</TableRow>
			</thead>
			<tbody>
				{
					rows.map((row) => (
						<TableRow>
							<TableCell>
								<span class='font-mono whitespace-nowrap'>{row.command}</span>
								{row.mock && (
									<span class='ml-1.5 font-mono text-[9px]/[1.4] tracking-[0.12em] text-clay uppercase'>mock</span>
								)}
							</TableCell>
							<TableCell class='font-mono tabular-nums'>{row.p50}</TableCell>
							<TableCell class='font-mono tabular-nums'>{row.p95}</TableCell>
							<TableCell class='font-mono tabular-nums'>{row.memory}</TableCell>
							<TableCell class='font-mono tabular-nums'>{row.output}</TableCell>
						</TableRow>
					))
				}
			</tbody>
		</Table>
		<PricingNote>p95 and the last three commands are placeholders. The other columns are measured.</PricingNote>
	</div>
</Section>
