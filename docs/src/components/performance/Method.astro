---
import PricingBody from "../pricing/PricingBody.astro";
import Section from "../pricing/Section.astro";

import { energyLabel, energyMethodNote, nodeEnergyLabel } from "../pricing/figures";
import { performanceNote } from "./flow-data";
---

<Section id='perf-method' label='Method' title='What these figures are.'>
	<div class='min-w-0'>
		<PricingBody>{performanceNote}</PricingBody>
		<PricingBody>
			Node timings and install timings are placeholders. {energyMethodNote} The read flow uses about
			{energyLabel("zinn task list --json")} above idle, and Node accounts for {nodeEnergyLabel}.
		</PricingBody>
	</div>
</Section>
