---
import type { Flow } from "./flow-data";

import PricingLabel from "../pricing/PricingLabel.astro";
import { formatMs } from "./flow-ui";

interface Props {
	flow: Flow;
	class?: string;
}

const { flow, class: className } = Astro.props;
---

<div class={className}>
	<div class='flex items-baseline justify-between gap-2'>
		<PricingLabel as='p' class='text-soot-muted-foreground'>Time split</PricingLabel>
		<p class='m-0 font-mono text-[10px]/[1.4] tabular-nums text-soot-muted-foreground'>{formatMs(flow.totalMs)}</p>
	</div>
	<div class='mt-2 flex h-2 w-full overflow-hidden bg-limestone/10'>
		{
			flow.timeSplit.map((segment) => (
				<span
					class='block h-full'
					style={`width: ${(segment.ms / flow.totalMs) * 100}%; background-color: ${segment.color}`}
					title={`${segment.label}: ${formatMs(segment.ms)}`}
				/>
			))
		}
	</div>

	<ul class='mt-3 grid gap-1.5'>
		{
			flow.timeSplit.map((segment) => (
				<li class='flex items-center justify-between gap-2 font-mono text-[10px]/[1.4] text-soot-muted-foreground'>
					<span class='flex min-w-0 items-center gap-1.5'>
						<span class='block size-2 shrink-0' style={`background-color: ${segment.color}`} />
						<span>{segment.label}</span>
					</span>
					<span class='shrink-0 tabular-nums text-limestone/80'>{formatMs(segment.ms)}</span>
				</li>
			))
		}
	</ul>
</div>
