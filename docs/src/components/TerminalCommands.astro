---
import CopyButton from "./CopyButton.astro";

interface Props {
	label: string;
	commands: string[];
	class?: string;
	showsPrompt?: boolean;
	wraps?: boolean;
}
const { label, commands, class: className, showsPrompt = true, wraps = false } = Astro.props;
---

<div class:list={["group/terminal mb-6", className]} data-terminal>
	<div class='flex items-start bg-soot text-soot-foreground scheme-dark'>
		<pre
			class:list={[
				"command-block min-w-0 flex-1 overflow-x-auto p-5 pr-0 text-[13px] leading-[1.8] selection:bg-limestone! selection:text-soot! md:p-6 md:pr-0 md:text-[14px]",
				wraps ? "whitespace-pre-wrap wrap-anywhere" : "whitespace-normal"
			]}
			tabindex='0'
			role='region'
			aria-label={label}>
			<code class='block'>
				{commands.map((command) => (
						<span data-terminal-command class:list={['block', !wraps && 'whitespace-nowrap', '[&:not(:first-child)]:mt-[1.8em]']}>
						{showsPrompt && <span data-terminal-prompt class='text-bronze select-none' aria-hidden='true'>$ </span>}
							<span class:list={[wraps ? 'whitespace-pre-wrap wrap-anywhere' : 'whitespace-pre']} set:text={command} />
					</span>
				))}
			</code>
		</pre>

		<CopyButton
			class='m-1 shrink-0 md:m-2'
			variant='ghost-inverted'
			size='icon'
			value={commands.join("\n")}
			label={`${showsPrompt ? "Copy commands" : "Copy code"}: ${label}`}
			title={showsPrompt ? "Copy commands" : "Copy code"}
			success={showsPrompt ? "Commands copied to clipboard." : "Code copied to clipboard."}
			event='command-copy'
			eventData={{ target: label.slice(0, 100), kind: showsPrompt ? "command" : "code" }}
		/>
	</div>
</div>
