---
import Icon from "./ui/icon/Icon.astro";

interface Props {
	lightboxId: string;
	image: string;
	width: number;
	height: number;
	alt: string;
	caption: string;
	class?: string;
}

const { lightboxId, image, width, height, alt, caption, class: className } = Astro.props;
---

<div class:list={[className]}>
	<a
		class='group/shot relative block cursor-zoom-in border border-pewter focus-visible:outline-offset-4'
		href={image}
		target='_blank'
		rel='noopener'
		data-lightbox={lightboxId}
		data-lightbox-title={caption}
		aria-label={`Enlarge ${alt}`}>
		<img
			class='block h-auto w-full'
			src={image}
			width={width}
			height={height}
			alt={alt}
			loading='lazy'
			decoding='async'
		/>
		<span
			class='absolute right-2 bottom-2 inline-flex items-center gap-2 border border-pewter bg-limestone px-2 py-1.5 font-mono text-[10px] text-soot md:opacity-0 md:group-hover/shot:opacity-100 md:group-focus-visible/shot:opacity-100'>
			Enlarge <Icon name='external-link' class='size-3.5' />
		</span>
	</a>
	<p class='mt-2 font-mono text-[11px] text-bone'>{caption}</p>
</div>
