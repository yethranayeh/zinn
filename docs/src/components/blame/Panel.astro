---
import { outputLines } from "./example";

interface Props {
	label?: string;
}

const { label = "Task blame output" } = Astro.props;
---

<div
	class='mb-0 [&_[data-state=focus]]:opacity-100 [&_[data-state=near]]:opacity-60 [&_[data-state=far]]:opacity-25'
	data-blame-panel>
	<div class='bg-soot text-soot-foreground scheme-dark'>
		<pre
			class='command-block overflow-x-auto whitespace-normal p-5 text-[13px] leading-[1.8] selection:bg-limestone! selection:text-soot! md:p-6 md:text-[14px]'
			tabindex='0'
			role='region'
			aria-label={label}>
      <code class='block'>
        {
          outputLines.map((line, index) => (
            <span data-line={index} class='block whitespace-pre' set:text={line === "" ? "\u00a0" : line} />
          ))
        }
      </code>
    </pre>
	</div>
</div>
