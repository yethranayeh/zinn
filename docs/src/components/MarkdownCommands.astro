---
import TerminalCommands from "./TerminalCommands.astro";

// Renders a fenced shell block from MDX; a blank line separates its commands.
interface Props {
	"data-label": string;
	"data-commands": string;
}

const { "data-label": label, "data-commands": commands } = Astro.props;
---

<TerminalCommands label={label} commands={commands.trim().split(/\n\s*\n/)} />
