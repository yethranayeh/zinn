---
import TerminalCommands from "./TerminalCommands.astro";
import { splitShellCommands, startsWithShebang } from "../markdown/shell-commands";

interface Props {
	"data-label"?: string;
	"data-commands": string;
	"data-language"?: string;
}

const { "data-label": sourceLabel, "data-commands": commands, "data-language": language = "text" } = Astro.props;
const isShell = ["sh", "bash", "shell"].includes(language);
const isScript = isShell && startsWithShebang(commands);
const isCommandList = isShell && !isScript;
const blockKind = isCommandList ? "commands" : isScript ? "script" : "example";
const label = sourceLabel ?? `${language === "text" ? "Code" : language} ${blockKind}`;
const commandList = isCommandList ? splitShellCommands(commands) : [commands.replace(/^\n|\n$/g, "")];
---

<TerminalCommands label={label} commands={commandList} showsPrompt={isCommandList} />
