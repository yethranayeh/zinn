---
import TerminalCommands from "./TerminalCommands.astro";
import { splitShellCommands } from "../markdown/shell-commands";

interface Props {
	"data-label"?: string;
	"data-commands": string;
	"data-language"?: string;
}

const { "data-label": sourceLabel, "data-commands": commands, "data-language": language = "text" } = Astro.props;
const isShell = ["sh", "bash", "shell"].includes(language);
const label = sourceLabel ?? `${language === "text" ? "Code" : language} ${isShell ? "commands" : "example"}`;
const commandList = isShell ? splitShellCommands(commands) : [commands.replace(/^\n|\n$/g, "")];
---

<TerminalCommands label={label} commands={commandList} showsPrompt={isShell} />
