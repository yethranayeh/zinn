---
import Button from "../ui/button/Button.astro";
import FurtherReadingArrow from "./FurtherReadingArrow.astro";
import FurtherReadingBracket from "./FurtherReadingBracket.astro";

import { isProductionSite } from "../../config/site";
---

<section aria-labelledby='further-reading-heading' class='shrink-0' data-further-reading hidden>
	<div
		id='further-reading-heading'
		class='flex items-center gap-2 border-b border-soot/22 font-mono text-xs text-muted-foreground'
		data-further-reading-title>
		<FurtherReadingBracket class='absolute -left-2.5 h-3' />
		Further reading
	</div>

	<div data-further-reading-rows hidden>
		<FurtherReadingArrow direction='up' />
		{/* Three rows: each is two lines and 1rem of padding, with 0.25rem between rows */}
		<ul
			class='relative max-h-[calc(3*(2lh+1rem)+0.5rem)] snap-y snap-mandatory space-y-1 overflow-y-auto overscroll-contain font-mono text-xs leading-relaxed scrollbar-none'
			data-further-reading-list>
		</ul>
		<FurtherReadingArrow direction='down' />
		{
			!isProductionSite && (
				<Button
					variant='outline'
					aria-pressed='false'
					class='mt-3 min-h-0 px-2 py-1 aria-pressed:bg-soot aria-pressed:text-soot-foreground'
					data-further-reading-debug>
					Debug
				</Button>
			)
		}
	</div>

	<p class='px-3 font-mono text-xs text-muted-foreground' data-further-reading-unavailable hidden>
		Further reading is unavailable.
	</p>

	<template data-further-reading-row>
		<li class='snap-start'>
			<a
				class='grid grid-cols-[2ch_minmax(0,1fr)] gap-x-2 border-l-2 border-transparent hover:bg-soot/8 hover:no-underline focus-visible:-outline-offset-2 data-current:border-clay data-pointed:bg-soot/8'>
				<span class='col-start-1 row-start-1 text-right text-clay tabular-nums' data-further-reading-number></span>
				<span class='col-start-2 row-start-1 h-lh truncate' data-further-reading-heading></span>
				<span class='col-start-2 h-lh truncate text-muted-foreground' data-further-reading-page></span>
			</a>
		</li>
	</template>

	<template data-further-reading-bracket>
		<FurtherReadingBracket interactive class='absolute' />
	</template>
</section>

<script>
	import type { DebugView } from "./further-reading/debug";
	import type { Model, Sentence } from "./further-reading/model";

	import { drawBrackets } from "./further-reading/brackets";
	import { createRowList } from "./further-reading/list";
	import { buildModel } from "./further-reading/model";
	import { followReading } from "./further-reading/reading";

	// The condition of isProductionSite in config/site.ts. Written out here because Vite folds it only within this module,
	// and only a folded condition lets the production build leave out the debug view's chunk.
	const isProductionBuild = import.meta.env.PROD && import.meta.env.PUBLIC_SITE_ENV === "production";
	const originHighlight = "further-reading-origin";
	// The aside holding this list shows from Tailwind's lg breakpoint
	const wideScreen = window.matchMedia("(min-width: 64rem)");

	function clearOrigin() {
		CSS.highlights.delete(originHighlight);
	}

	function showOrigin(range: Range) {
		CSS.highlights.set(originHighlight, new Highlight(range));
	}

	async function start(root: HTMLElement) {
		const unavailable = root.querySelector<HTMLElement>("[data-further-reading-unavailable]")!;
		let model: Model;

		try {
			model = await buildModel();
		} catch {
			// Every page that renders this list has a data file in a full build, so a failed load means the data is missing, as under astro dev.
			unavailable.hidden = false;
			root.hidden = false;
			return;
		}

		if (model.rows.length === 0) {
			return;
		}

		const rowsPanel = root.querySelector<HTMLElement>("[data-further-reading-rows]")!;
		const title = root.querySelector<HTMLElement>("[data-further-reading-title]")!;
		const bracketTemplate = root.querySelector<HTMLTemplateElement>("[data-further-reading-bracket]")!;
		const layer = document.querySelector<HTMLElement>("[data-further-reading-marks]");
		const [up, down] = ["up", "down"].map(
			(direction) => root.querySelector<HTMLElement>(`[data-further-reading-arrow=${direction}]`)!
		);
		const rowList = createRowList(
			{
				section: root,
				list: root.querySelector<HTMLUListElement>("[data-further-reading-list]")!,
				up,
				down,
				template: root.querySelector<HTMLTemplateElement>("[data-further-reading-row]")!
			},
			model.rows
		);
		const sentenceByKey = new Map(model.sentences.map((sentence) => [sentence.key, sentence]));
		let brackets = new Map<string, HTMLElement>();
		let debug: DebugView | undefined;

		/** Marks the sentence's bracket active and highlights the sentence. */
		function setActive(sentence: Sentence, isActive: boolean) {
			brackets.get(sentence.key)?.toggleAttribute("data-active", isActive);

			if (isActive) {
				showOrigin(sentence.range);
			} else {
				clearOrigin();
			}
		}

		/** Draws the brackets, then wires pointing at one to mark its rows and clicking its number to bring them into the window. */
		function drawAndWireBrackets() {
			brackets = layer === null ? new Map() : drawBrackets(layer, bracketTemplate, model.sentences);

			for (const [key, bracket] of brackets) {
				const sentence = sentenceByKey.get(key)!;
				const indexes = rowList.indexesOf(sentence);
				const number = bracket.querySelector("button")!;

				const point = (isPointed: boolean) => {
					for (const index of indexes) {
						rowList.items[index].anchor.toggleAttribute("data-pointed", isPointed);
					}

					setActive(sentence, isPointed);
				};

				bracket.addEventListener("mouseenter", () => point(true));
				bracket.addEventListener("mouseleave", () => point(false));
				number.addEventListener("focus", () => point(true));
				number.addEventListener("blur", () => point(false));
				number.addEventListener("click", () => {
					const decision = rowList.reveal(indexes, sentence.number);

					if (!isProductionBuild) {
						debug?.decided(decision);
					}
				});
			}
		}

		for (const { row, anchor } of rowList.items) {
			for (const show of ["mouseenter", "focus"]) {
				anchor.addEventListener(show, () => setActive(row.sentence, true));
			}

			for (const hide of ["mouseleave", "blur"]) {
				anchor.addEventListener(hide, () => setActive(row.sentence, false));
			}
		}

		// Pointing at the heading gives every bracket the active style
		function setAllActive(isActive: boolean) {
			for (const bracket of brackets.values()) {
				bracket.toggleAttribute("data-active", isActive);
			}
		}

		title.addEventListener("mouseenter", () => setAllActive(true));
		title.addEventListener("mouseleave", () => setAllActive(false));

		rowsPanel.hidden = false;
		root.hidden = false;

		if (!isProductionBuild) {
			const { createDebugView } = await import("./further-reading/debug");
			debug = createDebugView(root);
		}

		// Brackets and the reading band follow the text's layout, which settles once the fonts are in
		await document.fonts.ready;
		drawAndWireBrackets();
		window.addEventListener("resize", drawAndWireBrackets, { passive: true });
		followReading(model.sentences, (current, band) => {
			const decision = rowList.follow(current);

			if (!isProductionBuild) {
				debug?.settle(band, current, decision);
			}
		});
	}

	const section = document.querySelector<HTMLElement>("[data-further-reading]");

	if (section !== null) {
		if (wideScreen.matches) {
			void start(section);
		} else {
			wideScreen.addEventListener("change", () => void start(section), { once: true });
		}
	}
</script>
