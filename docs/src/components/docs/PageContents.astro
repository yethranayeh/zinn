---
import type { MarkdownHeading } from "astro";
import ContentsLinks from "./ContentsLinks.astro";
import FurtherReading from "./FurtherReading.astro";

interface Props {
	headings: Array<MarkdownHeading>;
	mobile?: boolean;
}

const { headings, mobile = false } = Astro.props;
---

{
	mobile ? (
		<details class='group shrink-0 lg:hidden' data-page-contents data-pagefind-ignore>
			<summary
				aria-label='On this page'
				class='flex min-h-12 cursor-pointer list-none items-center gap-3 font-mono text-xs [&::-webkit-details-marker]:hidden'>
				<span class='sm:hidden'>Contents</span>
				<span class='hidden sm:inline'>On this page</span>
				<span aria-hidden='true' class='group-open:hidden'>
					+
				</span>
				<span aria-hidden='true' class='hidden group-open:inline'>
					-
				</span>
			</summary>
			<nav
				aria-label='On this page'
				class='absolute top-full right-0 left-0 max-h-[60svh] overflow-y-auto overscroll-contain border-b border-soot/22 bg-limestone px-(--site-gutter) py-4'>
				<ContentsLinks headings={headings} />
			</nav>
		</details>
	) : (
		<aside class='hidden min-w-0 lg:block' data-pagefind-ignore>
			<div class='sticky top-[calc(var(--site-header-height)_+_var(--reading-rail-height)_+_2rem)] flex max-h-[calc(100svh_-_var(--site-header-height)_-_var(--reading-rail-height)_-_4rem)] flex-col'>
				<nav aria-label='On this page' class='flex min-h-0 flex-col'>
					<p class='mb-4 shrink-0 border-b border-soot/22 pb-3 font-mono text-xs text-muted-foreground'>On this page</p>
					<div class='min-h-0 overflow-y-auto overscroll-contain' data-contents-scroll>
						<ContentsLinks headings={headings} />
					</div>
				</nav>
				<FurtherReading />
			</div>
		</aside>
	)
}

<script>
	const rail = document.querySelector<HTMLElement>("[data-reading-rail]");
	const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-section-link]")];
	const targets = [...new Set(links.map((link) => document.getElementById(link.hash.slice(1))))].filter(
		(target): target is HTMLElement => target !== null
	);
	const header = document.querySelector<HTMLElement>("body > header");
	const disclosure = document.querySelector<HTMLDetailsElement>("[data-page-contents]");
	// The desktop list scrolls inside its own box when its entries do not fit
	const contentsBox = document.querySelector<HTMLElement>("[data-contents-scroll]");
	let currentBoxLink: HTMLAnchorElement | undefined;
	let scheduled = false;

	/** Scrolls the box, not the page, until the current entry is inside it. */
	function keepCurrentInBox() {
		if (contentsBox === null || currentBoxLink === undefined) {
			return;
		}

		const box = contentsBox.getBoundingClientRect();
		const entry = currentBoxLink.getBoundingClientRect();

		if (entry.top < box.top) {
			contentsBox.scrollTop -= box.top - entry.top;
		} else if (entry.bottom > box.bottom) {
			contentsBox.scrollTop += entry.bottom - box.bottom;
		}
	}

	function updateCurrent() {
		scheduled = false;
		const railHeight = rail?.getBoundingClientRect().height ?? 0;
		// The gap matches the document's scroll padding.
		const line = (header?.getBoundingClientRect().height ?? 0) + railHeight + 24;
		let reached: HTMLElement | undefined;

		for (const target of targets) {
			if (target.getBoundingClientRect().top <= line + 1) {
				reached = target;
			} else {
				break;
			}
		}
		// A page that fits the window stays on its first section until scrolled
		const isScrolled = window.scrollY > 0;
		const isAtBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1;

		if (isScrolled && isAtBottom) {
			reached = targets.at(-1) ?? reached;
		}

		const current = reached ?? targets[0];
		let currentLink: HTMLAnchorElement | undefined;

		for (const link of links) {
			if (current !== undefined && link.hash.slice(1) === current.id) {
				link.setAttribute("aria-current", "location");

				if (contentsBox?.contains(link)) {
					currentLink = link;
				}
			} else {
				link.removeAttribute("aria-current");
			}
		}

		// The box only follows when the current entry changes, so the reader can scroll it freely in between
		if (currentLink !== currentBoxLink) {
			currentBoxLink = currentLink;
			keepCurrentInBox();
		}
	}

	function scheduleCurrent() {
		if (scheduled) {
			return;
		}
		scheduled = true;
		requestAnimationFrame(updateCurrent);
	}

	for (const link of links) {
		link.addEventListener("click", () => {
			if (disclosure?.open) {
				disclosure.open = false;
				const target = document.getElementById(link.hash.slice(1));
				if (target) {
					target.tabIndex = -1;
					target.focus({ preventScroll: true });
				}
			}
		});
	}
	disclosure?.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			disclosure.open = false;
			disclosure.querySelector("summary")?.focus({ preventScroll: true });
		}
	});
	updateCurrent();
	window.addEventListener("scroll", scheduleCurrent, { passive: true });
	window.addEventListener("resize", scheduleCurrent);
	window.addEventListener("load", scheduleCurrent);
	if (rail) {
		new ResizeObserver(scheduleCurrent).observe(rail);
	}
	// Parts under the contents, such as further reading, change the box's height
	if (contentsBox) {
		new ResizeObserver(keepCurrentInBox).observe(contentsBox);
	}
	document.fonts.ready.then(scheduleCurrent);
</script>
