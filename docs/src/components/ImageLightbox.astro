---
import Button from "./ui/button/Button.astro";
import Dialog from "./ui/dialog/Dialog.astro";
import Icon from "./ui/icon/Icon.astro";

interface Props {
	id: string;
}

const { id } = Astro.props;
---

<Dialog
	id={id}
	title='Enlarged screenshot'
	class='max-h-[94svh] w-[96vw] max-w-450'
	data-image-lightbox
	data-pagefind-ignore>
	<Button slot='header' class='shrink-0' href='' target='_blank' rel='noopener' data-lightbox-original>
		<span class='max-sm:sr-only'>Open original</span>
		<Icon name='external-link' />
	</Button>
	<img class='block h-auto w-full' alt='' decoding='async' data-lightbox-image />
</Dialog>

<script>
	for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-image-lightbox]")) {
		const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]")!;
		const title = dialog.querySelector<HTMLElement>("[data-dialog-title]")!;
		const original = dialog.querySelector<HTMLAnchorElement>("[data-lightbox-original]")!;

		for (const trigger of document.querySelectorAll<HTMLAnchorElement>(`[data-lightbox="${dialog.id}"]`)) {
			trigger.addEventListener("click", (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
					return;
				}

				event.preventDefault();
				const preview = trigger.querySelector("img")!;
				// The preview's dimensions reserve the image's space before it loads.
				image.setAttribute("width", preview.getAttribute("width")!);
				image.setAttribute("height", preview.getAttribute("height")!);
				image.src = trigger.href;
				image.alt = preview.alt;
				title.textContent = trigger.dataset.lightboxTitle ?? preview.alt;
				original.href = trigger.href;
				dialog.showModal();
			});
		}

		// Otherwise the previous image shows until the next one loads.
		dialog.addEventListener("close", () => {
			image.removeAttribute("src");
		});
	}
</script>
