---
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
	id: string;
}

const { id } = Astro.props;
---

<dialog
	id={id}
	class='m-auto max-h-[94svh] w-[96vw] max-w-450 border border-pewter bg-limestone p-0 text-soot backdrop:bg-soot/90'
	aria-labelledby={`${id}-title`}
	data-image-lightbox>
	<div class='flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-pewter px-3 py-2 md:px-5'>
		<h2 id={`${id}-title`} class='mr-auto font-mono text-xs' data-lightbox-heading></h2>
		<a
			class='inline-flex min-h-11 items-center gap-2 font-mono text-xs'
			data-lightbox-original
			target='_blank'
			rel='noopener'>
			Open original <Icon name='external-link' />
		</a>
		<form method='dialog'>
			<Button type='submit' size='icon' aria-label='Close enlarged screenshot'><Icon name='close' /></Button>
		</form>
	</div>
	<div class='max-h-[calc(94svh_-_6.5rem)] overflow-auto md:max-h-[calc(94svh_-_4rem)]'>
		<img class='block h-auto w-full' data-lightbox-image alt='' />
	</div>
</dialog>

<script>
	for (const dialog of document.querySelectorAll<HTMLDialogElement>("[data-image-lightbox]")) {
		const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]")!;
		const heading = dialog.querySelector<HTMLElement>("[data-lightbox-heading]")!;
		const original = dialog.querySelector<HTMLAnchorElement>("[data-lightbox-original]")!;

		for (const trigger of document.querySelectorAll<HTMLAnchorElement>(`[data-lightbox="${dialog.id}"]`)) {
			trigger.addEventListener("click", (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
					return;
				}

				event.preventDefault();
				image.src = trigger.href;
				image.alt = trigger.querySelector("img")?.alt ?? "";
				heading.textContent = trigger.dataset.lightboxTitle ?? image.alt;
				original.href = trigger.href;
				dialog.showModal();
			});
		}

		dialog.addEventListener("click", (event) => {
			const bounds = dialog.getBoundingClientRect();
			const outside =
				event.clientX < bounds.left ||
				event.clientX > bounds.right ||
				event.clientY < bounds.top ||
				event.clientY > bounds.bottom;

			if (event.target === dialog && outside) {
				dialog.close();
			}
		});
	}
</script>
