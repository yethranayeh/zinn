---
import Branding from "./Branding.astro";
import NavLink from "./NavLink.astro";

const links = [
	{ name: "Installation", path: "/docs/installation" },
	{ name: "CHANGELOG", path: "/changelog" }
];
---

<header class='flex items-end justify-between gap-6 border-b border-pewter'>
	<Branding />

	<nav class='flex items-center gap-4 md:gap-7 font-mono text-xs leading-normal' aria-label='Zinn documentation'>
		{
			links.map((link) => (
				<NavLink class='pb-1' href={link.path}>
					{link.name}
				</NavLink>
			))
		}
	</nav>
</header>
