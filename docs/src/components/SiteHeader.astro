---
import Branding from "./Branding.astro";
import NavLink from "./NavLink.astro";
import Search from "./search/Search.astro";

const links = [
	{ name: "Docs", path: "/docs" },
	{ name: "Integrations", path: "/integrations" },
	{ name: "CHANGELOG", path: "/changelog" }
];
---

<header
	class='sticky top-0 z-20 min-h-[calc(var(--site-brand-height)_+_1px)] shrink-0 border-b border-soot bg-limestone'>
	<div class='site-container flex min-h-[var(--site-brand-height)] items-end justify-between gap-x-4'>
		<Branding />

		<div class='flex min-w-0 flex-auto items-end justify-end self-stretch sm:flex-none sm:self-end'>
			<Search />

			<nav
				class='grid h-11 min-w-0 flex-auto grid-cols-[1fr_2fr] grid-rows-[22px_22px] font-mono text-xs leading-normal min-[420px]:flex min-[420px]:flex-nowrap min-[420px]:items-stretch min-[420px]:flex-none min-[420px]:justify-end min-[420px]:gap-0 sm:h-6'
				aria-label='Zinn documentation'>
				{
					links.map((link) => (
						<NavLink variant='header' href={link.path}>
							{link.name}
						</NavLink>
					))
				}
			</nav>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("header");

	if (header) {
		const updateHeaderHeight = () => {
			document.documentElement.style.setProperty("--site-header-height", `${header.getBoundingClientRect().height}px`);
		};

		updateHeaderHeight();
		new ResizeObserver(updateHeaderHeight).observe(header);
	}
</script>
