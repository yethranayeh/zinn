---
import Branding from "./Branding.astro";

interface Props {
	linkHome?: boolean;
}

const { linkHome = true } = Astro.props;
const links = [{ name: "Installation", path: "/docs/installation" }];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<header class='flex items-center justify-between gap-6'>
	<Branding linked={linkHome} />
	<nav class='flex items-center gap-7 font-mono text-xs leading-normal' aria-label='Zinn documentation'>
		{
			links.map((link) => (
				<a class='py-2' href={link.path} aria-current={link.path === currentPath ? "page" : undefined}>
					{link.name}
				</a>
			))
		}
	</nav>
</header>
