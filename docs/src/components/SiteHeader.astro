---
import Branding from "./Branding.astro";
import MobileMenu from "./header/MobileMenu.astro";
import NavLink from "./NavLink.astro";
import Search from "./search/Search.astro";

import { headerLinks } from "./header/links";
---

<header
	class='sticky top-0 z-20 min-h-[calc(var(--site-brand-height)_+_1px)] shrink-0 border-b border-soot bg-limestone'>
	<div class='site-container flex min-h-[var(--site-brand-height)] items-end justify-between gap-x-4'>
		<Branding />

		<div class='flex min-w-0 flex-auto items-end justify-end self-stretch sm:flex-none sm:self-end'>
			<Search />
			<MobileMenu />

			<nav class='hidden h-6 items-stretch font-mono text-xs leading-normal sm:flex' aria-label='Zinn documentation'>
				{
					headerLinks.map((link) => (
						<NavLink variant='header' href={link.path}>
							{link.name}
						</NavLink>
					))
				}
			</nav>
		</div>
	</div>

	<noscript>
		<style>
			/* Brand row plus the no-JS fallback row: 1.5rem padding, 1.5rem links and the top rule. */
			:root {
				--site-header-height: calc(var(--site-brand-height) + 1px + 3.0625rem);
			}
		</style>
		<nav
			class='flex flex-wrap gap-x-6 gap-y-3 border-t border-soot/22 px-6 py-3 font-mono text-xs sm:hidden'
			aria-label='Zinn documentation'>
			{
				headerLinks.map((link) => (
					<NavLink class='inline-flex min-h-6 items-center' href={link.path}>
						{link.name}
					</NavLink>
				))
			}
		</nav>
	</noscript>
</header>

<script>
	const header = document.querySelector<HTMLElement>("header");

	if (header) {
		const updateHeaderHeight = () => {
			document.documentElement.style.setProperty("--site-header-height", `${header.getBoundingClientRect().height}px`);
		};

		updateHeaderHeight();
		new ResizeObserver(updateHeaderHeight).observe(header);
	}
</script>
