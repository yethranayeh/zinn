---
import MarkdownH2 from "../MarkdownH2.astro";
import Prose from "../Prose.astro";
import PackageBand from "./PackageBand.astro";

import { formatReleaseDate, getRelease, releaseAnchor } from "../../config/releases";

interface Props {
	version: string;
	first?: boolean;
}

const { version, first = false } = Astro.props;
const release = getRelease(version);
const anchor = releaseAnchor(release.version);
---

<section aria-labelledby={anchor} class='release-plate-section'>
	<div class='site-container'>
		<div class='release-plate'>
			<div
				aria-hidden='true'
				class:list={[
					"reading-frame pointer-events-none absolute inset-0 border-x border-pewter",
					{ "frame-start": first }
				]}>
			</div>
			<div class='release-plate-content'>
				<div class='rail-rule' aria-hidden='true'></div>
				<div class='rail-grid'>
					<div class='rail-meta'>
						<Prose>
							<MarkdownH2 id={anchor} style='margin-top: 0; margin-bottom: 0.5rem'>
								<span class='rail-version'>{release.version}</span>
								{release.name && <span class='rail-name'>{release.name}</span>}
							</MarkdownH2>
							<time class='rail-date' datetime={release.date}>
								{formatReleaseDate(release.date)}
							</time>
							<PackageBand cli={release.cli} core={release.core} />
						</Prose>
					</div>
					<div class='rail-notes'>
						<Prose>
							<div class='release-notes'>
								<slot />
							</div>
						</Prose>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.release-plate-section {
		border-top: 1px solid var(--color-soot);
	}

	.release-plate {
		--plate-padding-inline: 2rem;
		--rail-width: 14rem;
		--rail-gap: 3rem;
		--rail-meta-padding-right: 1.5rem;
		position: relative;
		max-width: 64rem;
	}

	.release-plate-content {
		padding-block: 2.5rem;
		padding-inline: var(--plate-padding-inline);
	}

	.rail-rule {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--plate-padding-inline) + var(--rail-width));
		width: 1px;
		background: var(--color-pewter);
	}

	.rail-grid {
		display: grid;
		grid-template-columns: var(--rail-width) minmax(0, 1fr);
		column-gap: var(--rail-gap);
		align-items: start;
	}

	.rail-meta {
		align-self: start;
		padding-right: var(--rail-meta-padding-right);
		position: sticky;
		top: calc(var(--site-header-height) + 1.5rem);
	}

	.rail-version {
		display: block;
	}

	.rail-name {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.rail-date {
		display: block;
		font-size: 1rem;
		font-weight: 400;
		opacity: 0.7;
	}

	.release-notes > :global(h3:first-child) {
		margin-top: 0;
	}

	@media (min-width: 768px) {
		.release-plate-content {
			padding-block: 3.5rem;
		}
	}

	@media (max-width: 48rem) {
		.release-plate {
			--plate-padding-inline: 1rem;
		}
	}

	@media (max-width: 64rem) {
		.rail-rule {
			display: none;
		}

		.rail-grid {
			grid-template-columns: 1fr;
		}

		.rail-meta {
			position: static;
			padding-right: 0;
			padding-bottom: 1.5rem;
			margin-bottom: 0.5rem;
		}
	}
</style>
