---
import type { ReleasePackage } from "../../config/changelog";
import MarkdownH2 from "../MarkdownH2.astro";
import Prose from "../Prose.astro";
import PackageBand from "./PackageBand.astro";

import { formatReleaseDate } from "../../config/changelog";

interface Props {
	anchor: string;
	heading: string;
	name?: string;
	date: string;
	packages: ReleasePackage[];
	first?: boolean;
}

const { anchor, heading, name, date, packages, first = false } = Astro.props;
---

<section aria-labelledby={anchor} class='border-t border-soot'>
	<div class='site-container'>
		<div class='release-plate relative max-w-5xl'>
			<div
				aria-hidden='true'
				class:list={[
					"reading-frame pointer-events-none absolute inset-0 border-x border-pewter",
					{ "frame-start": first }
				]}>
			</div>

			<div class='pt-2'>
				<div class='rail-rule max-md:hidden' aria-hidden='true'></div>

				<div class='grid grid-cols-1 items-start md:grid-cols-[var(--rail-width)_minmax(0,1fr)] px-0'>
					<div class='md:sticky md:top-[var(--site-header-height)] lg:pr-[var(--rail-meta-padding-right)]'>
						<Prose class='px-2'>
							<MarkdownH2 id={anchor} class='m-0!'>
								<span class='block'>{heading}</span>
								{
									name && (
										<span class='mt-1 block text-sm leading-normal font-normal tracking-[0.12em] text-muted-foreground uppercase'>
											{name}
										</span>
									)
								}
							</MarkdownH2>
							<time class='block text-base leading-[1.7] font-normal text-muted-foreground' datetime={date}>
								{formatReleaseDate(date)}
							</time>
						</Prose>
						<PackageBand packages={packages} />
					</div>

					<Prose class='px-4'>
						<div class='[&>h3:first-child]:m-0! [&_ul]:m-0 [&_li]:m-0'>
							<slot />
						</div>
					</Prose>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.release-plate {
		--plate-padding-inline: 0px;
		--rail-width: 200px;
		--rail-meta-padding-right: 1.5rem;
	}

	.rail-rule {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--plate-padding-inline) + var(--rail-width));
		width: 1px;
		background: var(--color-pewter);
	}

	@media (max-width: 48rem) {
		.release-plate {
			--plate-padding-inline: 1rem;
		}
	}
</style>
