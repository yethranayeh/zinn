---
import MarkdownH2 from "../MarkdownH2.astro";
import Prose from "../Prose.astro";
import PackageBand from "./PackageBand.astro";

import { formatReleaseDate, releaseAnchor } from "../../config/changelog";

interface Props {
	version: string;
	name?: string;
	date: string;
	cli: string;
	core: string;
	first?: boolean;
}

const { version, name, date, cli, core, first = false } = Astro.props;
const anchor = releaseAnchor(version);
---

<section aria-labelledby={anchor} class='border-t border-soot'>
	<div class='site-container'>
		<div class='release-plate relative max-w-5xl'>
			<div
				aria-hidden='true'
				class:list={[
					"reading-frame pointer-events-none absolute inset-0 border-x border-pewter",
					{ "frame-start": first }
				]}>
			</div>
			<div class='px-[var(--plate-padding-inline)] py-10 md:py-14'>
				<div class='rail-rule max-lg:hidden' aria-hidden='true'></div>
				<div
					class='grid grid-cols-1 items-start gap-x-[var(--rail-gap)] lg:grid-cols-[var(--rail-width)_minmax(0,1fr)]'>
					<div
						class='max-lg:mb-2 max-lg:pb-6 lg:sticky lg:top-[calc(var(--site-header-height)_+_1.5rem)] lg:pr-[var(--rail-meta-padding-right)]'>
						<Prose>
							<MarkdownH2 id={anchor} style='margin-top: 0; margin-bottom: 0.5rem'>
								<span class='block'>{version}</span>
								{
									name && (
										<span class='mt-1 block text-sm leading-normal font-normal tracking-[0.12em] text-muted-foreground uppercase'>
											{name}
										</span>
									)
								}
							</MarkdownH2>
							<time class='block text-base leading-[1.7] font-normal text-muted-foreground' datetime={date}>
								{formatReleaseDate(date)}
							</time>
							<PackageBand cli={cli} core={core} />
						</Prose>
					</div>
					<div>
						<Prose>
							<div class='[&>h3:first-child]:mt-0'>
								<slot />
							</div>
						</Prose>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.release-plate {
		--plate-padding-inline: 2rem;
		--rail-width: 14rem;
		--rail-gap: 3rem;
		--rail-meta-padding-right: 1.5rem;
	}

	.rail-rule {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--plate-padding-inline) + var(--rail-width));
		width: 1px;
		background: var(--color-pewter);
	}

	@media (max-width: 48rem) {
		.release-plate {
			--plate-padding-inline: 1rem;
		}
	}
</style>
