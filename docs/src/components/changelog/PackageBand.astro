---
import { npmPackageUrl } from "../../config/changelog";

interface Props {
	cli: string;
	core: string;
}

const { cli, core } = Astro.props;
---

<div
	class='relative mt-5 grid grid-cols-2 border-y border-soot text-sm leading-[1.6] after:absolute after:-top-px after:-bottom-px after:left-1/2 after:w-px after:bg-soot after:content-[""] lg:-ml-[var(--plate-padding-inline)] lg:-mr-[var(--rail-meta-padding-right)]'>
	<a href={npmPackageUrl("cli", cli)} class='block py-1.5 text-center'>CLI {cli}</a>
	<a href={npmPackageUrl("core", core)} class='block py-1.5 text-center'>Core {core}</a>
</div>
