---
import type { ReleasePackage } from "../../config/changelog";

interface Props {
	packages: ReleasePackage[];
}

const { packages } = Astro.props;
---

<div
	class='mt-5 flex flex-wrap gap-px border-y border-soot bg-soot text-sm leading-[1.6] lg:-ml-(--plate-padding-inline) lg:-mr-(--rail-meta-padding-right)'>
	{
		packages.map(({ label, url }) => (
			<a href={url} class='block grow shrink basis-[calc(50%-0.5px)] min-w-max bg-limestone py-1.5 text-center'>
				{label}
			</a>
		))
	}
</div>
