---
import type { InspectorCollagePart } from "../config/opencode-inspector";

import FigureCallout from "./FigureCallout.astro";

interface Props {
	base: string;
	width: number;
	height: number;
	caption: string;
	parts: InspectorCollagePart[];
	class?: string;
}

const { base, width, height, caption, parts, class: className } = Astro.props;
const percent = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
---

<figure class:list={["inspector-collage isolate", className]}>
	<div class='border border-pewter bg-soot p-3 text-soot-foreground scheme-dark md:p-7'>
		<div class='@container' data-collage>
			<div class='relative grid grid-cols-1 gap-3 @min-[640px]:grid-cols-2 @min-[880px]:block'>
				<div
					class='relative col-span-full outline-1 outline-solid outline-pewter'
					style={`aspect-ratio: ${width} / ${height}`}>
					<img
						class='absolute inset-0 size-full'
						src={base}
						width={width}
						height={height}
						alt=''
						loading='eager'
						decoding='async'
					/>
					{
						parts.map((part) =>
							part.states.map((state) => (
								<img
									class='absolute'
									data-part-image={part.id}
									data-image-label={state.label}
									src={state.image}
									width={part.width}
									height={state.height}
									alt={state.alt}
									hidden
									loading='lazy'
									decoding='async'
									style={`left: ${percent(part.x, width)}; top: ${percent(part.y, height)}; width: ${percent(part.width, width)}; height: ${percent(state.height, height)};`}
								/>
							))
						)
					}
					{
						parts.map((part, index) => (
							<span
								class='pointer-events-none absolute z-20 flex size-5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-bronze bg-soot font-mono text-[10px] text-bronze'
								style={`left: ${percent(part.x, width)}; top: ${part.callout.top}%;`}
								aria-hidden='true'>
								{index + 1}
							</span>
						))
					}
				</div>

				{
					parts.map((part, index) => (
						<div
							class='z-30 w-full @min-[880px]:absolute @min-[880px]:top-[var(--callout-top)] @min-[880px]:right-[var(--callout-right)] @min-[880px]:w-60 @min-[880px]:-translate-y-1/2'
							style={`--callout-top: ${part.callout.top}%; --callout-right: ${part.callout.right}%;`}>
							<FigureCallout
								number={index + 1}
								id={part.id}
								label={part.label}
								states={part.states.map((state) => state.label)}
							/>
						</div>
					))
				}
			</div>
		</div>
	</div>
	<figcaption class='mt-3 font-mono text-[11px] text-muted-foreground'>{caption}</figcaption>
</figure>

<script>
	for (const collage of document.querySelectorAll<HTMLElement>("[data-collage]")) {
		const callouts = [...collage.querySelectorAll<HTMLElement>("[data-callout]")];
		const images = [...collage.querySelectorAll<HTMLImageElement>("[data-part-image]")];
		const grouped = new Map<string, HTMLImageElement[]>();
		for (const image of images) {
			const part = image.dataset.partImage!;
			const partImages = grouped.get(part) ?? [];
			partImages.push(image);
			grouped.set(part, partImages);
		}
		const stateIndex: Record<string, number> = {};
		for (const part of grouped.keys()) {
			stateIndex[part] = 0;
		}
		let activePart: string | null = null;

		function render() {
			for (const [part, partImages] of grouped) {
				partImages.forEach((image, index) => {
					image.hidden = part !== activePart || index !== stateIndex[part];
				});
			}
			for (const callout of callouts) {
				const part = callout.dataset.callout!;
				const partImages = grouped.get(part) ?? [];
				const index = stateIndex[part] ?? 0;
				const stateLabel = callout.querySelector<HTMLElement>("[data-state-label]");
				const position = callout.querySelector<HTMLElement>("[data-position]");
				const controls = callout.querySelector<HTMLElement>("[data-controls]");
				if (stateLabel) {
					stateLabel.textContent = partImages[index]?.dataset.imageLabel ?? "";
				}
				if (position) {
					position.textContent = `${String(index + 1).padStart(2, "0")} / ${String(partImages.length).padStart(2, "0")}`;
				}
				if (controls) {
					controls.hidden = partImages.length <= 1;
				}
				if (part === activePart) {
					const announcement = callout.querySelector<HTMLElement>("[data-announcement]");
					if (announcement) {
						announcement.textContent = `${callout.dataset.partLabel}: ${partImages[index]?.dataset.imageLabel}. State ${index + 1} of ${partImages.length}.`;
					}
				}
			}
		}

		for (const callout of callouts) {
			const part = callout.dataset.callout!;
			callout.addEventListener("pointerenter", () => {
				activePart = part;
				render();
			});
			callout.addEventListener("pointerleave", () => {
				if (!callout.matches(":focus-within")) {
					activePart = null;
					render();
				}
			});
			callout.addEventListener("focusin", () => {
				activePart = part;
				render();
			});
			callout.addEventListener("focusout", () => {
				if (!callout.contains(document.activeElement)) {
					activePart = null;
					render();
				}
			});
			for (const button of callout.querySelectorAll<HTMLButtonElement>("[data-step]")) {
				button.addEventListener("click", () => {
					const partImages = grouped.get(part) ?? [];
					stateIndex[part] = ((stateIndex[part] ?? 0) + Number(button.dataset.step) + partImages.length) % partImages.length;
					render();
				});
			}
		}

		render();
	}
</script>
