---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	variant?: "solid" | "outline";
}

const { variant = "solid", class: className, ...attributes } = Astro.props;
---

<a
	class:list={[
		"inline-flex min-h-11 items-center justify-center gap-2 border px-4 py-3 text-sm no-underline hover:no-underline focus-visible:outline-offset-4",
		variant === "solid" ? "border-soot bg-soot text-limestone hover:bg-soot/90" : "border-soot hover:bg-soot/8",
		className
	]}
	{...attributes}>
	<slot />
</a>
