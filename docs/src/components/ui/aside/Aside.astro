---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

interface Props extends HTMLAttributes<"aside"> {
	label: string;
}

const { label, class: className, ...attributes } = Astro.props;
---

<aside
	aria-label={label}
	class={twMerge("my-6 border-l-[6px] border-clay bg-limestone px-3.5 py-2.5", className)}
	{...attributes}>
	<p class='font-semibold'>{label}</p>

	<div class='mt-1.5'>
		<slot />
	</div>
</aside>
