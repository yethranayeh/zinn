---
import type { TooltipPlacement } from "./variants";

import { twMerge } from "tailwind-merge";
import { tooltipVariants } from "./variants";

interface Props {
	text: string;
	placement?: TooltipPlacement;
	class?: string;
}

const { text, placement = tooltipVariants.defaultVariants.placement, class: className } = Astro.props;
const separator = placement.indexOf("-");
const side = placement.slice(0, separator);
const align = placement.slice(separator + 1);
const tooltipId = `tooltip-${crypto.randomUUID()}`;
---

<span class={twMerge("group/tooltip relative inline-flex min-w-0", className)} data-tooltip>
	<slot />
	<span
		class:list={[tooltipVariants.base, tooltipVariants.variants.placement[placement]]}
		id={tooltipId}
		role='tooltip'
		data-placement={placement}
		data-side={side}
		data-align={align}>{text}</span
	>
</span>

<script>
	const tooltips = document.querySelectorAll<HTMLElement>("[data-tooltip]");
	for (const tooltip of tooltips) {
		const trigger = tooltip.querySelector<HTMLElement>("button, a[href]");
		const content = tooltip.querySelector<HTMLElement>("[role=tooltip]")!;
		const originalText = content.textContent;
		if (trigger) {
			const descriptions = [trigger.getAttribute("aria-describedby"), content.id].filter(Boolean);
			trigger.setAttribute("aria-describedby", descriptions.join(" "));
		}

		function resetDismissal() {
			if (!tooltip.matches(":hover, :has(:focus-visible)")) {
				tooltip.removeAttribute("data-tooltip-dismissed");
			}
		}

		tooltip.addEventListener("pointerleave", resetDismissal);
		tooltip.addEventListener("focusout", () => queueMicrotask(resetDismissal));
		tooltip.addEventListener("tooltip-message", (event) => {
			const message = (event as CustomEvent<string | null>).detail;
			content.textContent = message ?? originalText;
			tooltip.toggleAttribute("data-tooltip-open", message !== null);
			if (message !== null) {
				tooltip.removeAttribute("data-tooltip-dismissed");
			}
		});
	}

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			for (const tooltip of tooltips) {
				if (tooltip.matches("[data-tooltip-open], :hover, :has(:focus-visible)")) {
					tooltip.setAttribute("data-tooltip-dismissed", "");
				}
			}
		}
	});
</script>
