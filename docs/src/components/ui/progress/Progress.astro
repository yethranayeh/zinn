---
import type { HTMLAttributes } from "astro/types";

import { twMerge } from "tailwind-merge";

interface Props extends Omit<HTMLAttributes<"canvas">, "class"> {
	/** How much of the bar is filled, from 0 to 1 */
	value: number;
	class?: string;
}

const { value, class: className, ...attributes } = Astro.props;
---

<div class={twMerge("relative h-8", className)}>
	<canvas
		class='block absolute inset-x-0 w-full h-8'
		aria-hidden='true'
		data-progress
		data-value={value}
		{...attributes}></canvas>
</div>
