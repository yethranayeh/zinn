---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import ReservedGround from "../reserved-ground/ReservedGround.astro";

type Props = HTMLAttributes<"div">;

const { class: className, ...attributes } = Astro.props;
---

<div class={twMerge("relative isolate flex flex-col border border-soot bg-bone space-y-4", className)} {...attributes}>
	<ReservedGround class='absolute inset-0 -z-10' />
	<slot />
</div>
