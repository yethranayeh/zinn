---
import type { ButtonVariant } from "./variants";

import { twMerge } from "tailwind-merge";
import { buttonWipe } from "./variants";

interface Props {
	variant: ButtonVariant;
	animated: boolean;
}

const { variant, animated } = Astro.props;
const wipe = buttonWipe.variants[variant];
---

{
	animated ? (
		<>
			<slot />
			<span aria-hidden='true' class={twMerge(buttonWipe.overlay, wipe.pair)}>
				<slot />
			</span>
		</>
	) : (
		<slot />
	)
}

<style>
	@property --button-wipe {
		syntax: "<length-percentage>";
		inherits: false;
		initial-value: 0%;
	}

	/* The stair edge of the overlay, one cell per step. */
	.button-wipe {
		clip-path: polygon(
			0 0,
			calc(var(--button-wipe) - var(--button-wipe-cell)) 0,
			calc(var(--button-wipe) - var(--button-wipe-cell)) var(--button-wipe-cell),
			var(--button-wipe) var(--button-wipe-cell),
			var(--button-wipe) calc(var(--button-wipe-cell) * 2),
			calc(var(--button-wipe) - var(--button-wipe-cell) * 2) calc(var(--button-wipe-cell) * 2),
			calc(var(--button-wipe) - var(--button-wipe-cell) * 2) calc(var(--button-wipe-cell) * 3),
			calc(var(--button-wipe) - var(--button-wipe-cell)) calc(var(--button-wipe-cell) * 3),
			calc(var(--button-wipe) - var(--button-wipe-cell)) calc(var(--button-wipe-cell) * 4),
			var(--button-wipe) calc(var(--button-wipe-cell) * 4),
			var(--button-wipe) calc(var(--button-wipe-cell) * 5),
			calc(var(--button-wipe) - var(--button-wipe-cell) * 2) calc(var(--button-wipe-cell) * 5),
			calc(var(--button-wipe) - var(--button-wipe-cell) * 2) 100%,
			0 100%
		);

		/* Zero until the last step of the wipe, then one cell, so the corner cells open once the wipe is complete. */
		--button-notch: clamp(
			0px,
			(var(--button-wipe) - 100% - var(--button-wipe-cell) * 2 + 1px) * 1000,
			var(--button-wipe-cell)
		);

		/* Cuts six cells out of the overlay, showing the button's resting look through them. */
		mask-image:
			linear-gradient(#000 0 0), linear-gradient(#000 0 0), linear-gradient(#000 0 0), linear-gradient(#000 0 0),
			linear-gradient(#000 0 0), linear-gradient(#000 0 0), linear-gradient(#000 0 0);
		mask-size:
			100% 100%,
			var(--button-notch) var(--button-notch),
			var(--button-notch) var(--button-notch),
			var(--button-notch) var(--button-notch),
			var(--button-notch) var(--button-notch),
			var(--button-notch) var(--button-notch),
			var(--button-notch) var(--button-notch);
		mask-position:
			0 0,
			left 0 bottom calc(var(--button-wipe-cell) * 2),
			left var(--button-wipe-cell) bottom var(--button-wipe-cell),
			left 0 bottom 0,
			left calc(var(--button-wipe-cell) * 2) bottom 0,
			right var(--button-wipe-cell) top var(--button-wipe-cell),
			right 0 top 0;
		mask-repeat: no-repeat;
		mask-composite: exclude;
	}
</style>
