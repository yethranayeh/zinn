---
import type { HTMLAttributes } from "astro/types";

import { twMerge } from "tailwind-merge";
import { tableCellVariants } from "./variants";

type Props = HTMLAttributes<"td">;

const { class: className, ...attributes } = Astro.props;
---

<td class={twMerge(tableCellVariants.ledger, tableCellVariants.soot, className)} {...attributes}>
	<slot />
</td>
