---
import type { HTMLAttributes } from "astro/types";

import { twMerge } from "tailwind-merge";
import { tableRowVariants } from "./variants";

type Props = HTMLAttributes<"tr">;

const { class: className, ...attributes } = Astro.props;
---

<tr class={twMerge(tableRowVariants.ledger, tableRowVariants.soot, className)} {...attributes}>
	<slot />
</tr>
