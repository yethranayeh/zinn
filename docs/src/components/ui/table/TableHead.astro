---
import type { HTMLAttributes } from "astro/types";

import { twMerge } from "tailwind-merge";
import { tableHeadVariants } from "./variants";

type Props = HTMLAttributes<"th">;

const { class: className, ...attributes } = Astro.props;
---

<th class={twMerge(tableHeadVariants.ledger, tableHeadVariants.soot, className)} {...attributes}>
	<slot />
</th>
