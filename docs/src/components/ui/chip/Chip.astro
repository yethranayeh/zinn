---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

type Props = HTMLAttributes<"span">;

const { class: className, ...attributes } = Astro.props;
---

<span
	class={twMerge(
		"inline-block bg-soot px-2.5 py-1.25 font-mono text-xs leading-normal text-soot-foreground",
		className
	)}
	{...attributes}>
	<slot />
</span>
