---
import type { InspectorBlock, InspectorProseBlock, InspectorSection } from "./content";

import MarkdownH2 from "../MarkdownH2.astro";
import Prose from "../Prose.astro";
import AnnotatedFigure from "./AnnotatedFigure.astro";
import ProseBlock from "./ProseBlock.astro";

interface Props {
	sections: InspectorSection[];
}

const { sections } = Astro.props;

const isProseBlock = (block: InspectorBlock): block is InspectorProseBlock =>
	block.kind !== "figure";
const isFigureBlock = (block: InspectorBlock): block is Extract<InspectorBlock, { kind: "figure" }> =>
	block.kind === "figure";
---

{
	sections.map((section) => (
		<section>
			<div class='max-w-3xl'>
				<Prose>
					<MarkdownH2 id={section.id}>{section.heading}</MarkdownH2>
					{section.blocks.filter(isProseBlock).map((block) => (
						<ProseBlock block={block} />
					))}
				</Prose>
			</div>
			{section.blocks.filter(isFigureBlock).map((block) => (
				<AnnotatedFigure {...block.figure} class='my-12 md:my-16' />
			))}
		</section>
	))
}
