---
interface Props {
	href: string;
	class?: string;
	variant?: "default" | "header" | "drawer";
}

const { href, class: className, variant = "default" } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const targetPath = href.replace(/\/$/, "");
const isCurrentPage = currentPath === targetPath;

const headerCellClass = [
	"flex flex-none items-center justify-center border-l border-soot/22 bg-limestone font-mono text-xs leading-none whitespace-nowrap text-soot no-underline transition-none",
	"hover:bg-bone hover:text-soot hover:no-underline",
	"aria-[current=page]:border-cinnabar aria-[current=page]:bg-cinnabar aria-[current=page]:text-limestone",
	"aria-[current=page]:hover:bg-cinnabar aria-[current=page]:hover:text-limestone",
	"focus-visible:outline-2 focus-visible:-outline-offset-3",
	"max-[420px]:h-5.5 max-[420px]:nth-2:border-r max-[420px]:nth-3:col-span-full max-[420px]:nth-3:border-r max-[420px]:nth-3:border-t",
	"min-[420px]:h-11 min-[420px]:px-2 min-[420px]:last:border-r",
	"sm:h-6 sm:border sm:border-b-0 sm:px-3 sm:not-first:-ml-px sm:focus-visible:outline-offset-6"
].join(" ");

const drawerRowClass = [
	"flex min-h-16 items-center border-t border-limestone/20 px-6 font-mono text-[13px] tracking-wide no-underline first:border-t-0",
	"hover:bg-limestone/10 hover:no-underline",
	"aria-[current=page]:bg-limestone aria-[current=page]:text-soot aria-[current=page]:hover:bg-limestone",
	"focus-visible:outline-2 focus-visible:-outline-offset-2"
].join(" ");

const variantClass =
	variant === "header" ? headerCellClass : variant === "drawer" ? drawerRowClass : "aria-[current=page]:underline";
---

<a class:list={[className, variantClass]} href={href} aria-current={isCurrentPage ? "page" : undefined}>
	<slot />
</a>
