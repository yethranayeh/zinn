---
import { getCollection } from "astro:content";
import { getBreadcrumbItems, type BreadcrumbItem } from "../config/routes";
import { twMerge } from "tailwind-merge";

interface Props {
	/** Overrides the trail derived from the URL path. */
	items?: BreadcrumbItem[];
	class?: string;
}

const { items: suppliedItems, class: className } = Astro.props;
const items =
	suppliedItems ?? getBreadcrumbItems(Astro.url.pathname, Astro.locals.pageTitle, await getCollection("prose"));
const breadcrumbList = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: items.map((item, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: item.name,
		item: new URL(item.path, Astro.site).href
	}))
};
---

{
	items.length > 0 && (
		<>
			<nav class={twMerge("mb-8 font-mono text-xs", className)} aria-label='Breadcrumb'>
				<ol class='flex flex-wrap items-center gap-x-2 gap-y-1'>
					{items.map((item, index) => {
						const isCurrent = index === items.length - 1;
						return (
							<li class='flex items-center gap-x-2'>
								{index > 0 && <span aria-hidden='true'>/</span>}
								<a
									class:list={["py-2", isCurrent ? "no-underline" : "underline"]}
									href={item.path}
									aria-current={isCurrent ? "page" : undefined}>
									{item.name}
								</a>
							</li>
						);
					})}
				</ol>
			</nav>
			<script
				type='application/ld+json'
				is:inline
				set:html={JSON.stringify(breadcrumbList).replaceAll("<", "\\u003c")}
			/>
		</>
	)
}
