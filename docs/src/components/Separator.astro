---
// Adapted from https://ui.shadcn.com/docs/components/base/separator.
interface Props {
	orientation?: "horizontal" | "vertical";
	class?: string;
}

const { orientation = "horizontal", class: className } = Astro.props;
---

<div
	aria-hidden='true'
	data-orientation={orientation}
	class:list={["shrink-0 bg-pewter", orientation === "vertical" ? "w-px self-stretch" : "h-px w-full", className]}>
</div>
