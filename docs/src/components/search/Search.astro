---
import Button from "../ui/button/Button.astro";
import Dialog from "../ui/dialog/Dialog.astro";
import Icon from "../ui/icon/Icon.astro";
import Input from "../ui/input/Input.astro";
import Kbd from "../ui/kbd/Kbd.astro";

const resultLinkClass =
	"block scroll-mb-10 no-underline hover:bg-soot/8 hover:no-underline focus-visible:-outline-offset-3 data-active:bg-soot/8 [&_mark]:bg-bronze/40 [&_mark]:text-current";
const excerptClass = "mt-1 block text-sm text-muted-foreground";

const suggestions = [
	{
		title: "Install",
		excerpt: "Install, upgrade and uninstall the CLI and core library.",
		href: "/docs/installation/"
	},
	{
		title: "Quick start",
		excerpt: "Create a project, add a task, and move it through the board.",
		href: "/docs/quick-start/"
	},
	{
		title: "CLI reference",
		excerpt: "Project, task, label, relation, comment, and activity commands.",
		href: "/docs/cli/"
	},
	{
		title: "Core library",
		excerpt: "Use Zinn's core library with an explicitly configured database and actor.",
		href: "/docs/core/"
	},
	{
		title: "Data and backups",
		excerpt: "Understand storage, backups, restores, and database upgrades.",
		href: "/docs/data/"
	}
];
---

<Button
	class='h-11 w-9 shrink-0 border-l border-soot/22 p-0 hover:bg-bone focus-visible:outline-2 focus-visible:-outline-offset-3 max-[420px]:w-11 sm:-mr-px sm:h-6 sm:min-h-0 sm:w-auto sm:border sm:border-b-0 sm:px-3 sm:focus-visible:outline-offset-6 noscript:hidden'
	aria-haspopup='dialog'
	aria-keyshortcuts='Control+K Meta+K'
	data-search-open>
	<Icon name='search' class='size-4 sm:size-3.5' />
	<span class='max-sm:sr-only'>Search</span>
</Button>

<Dialog
	id='site-search'
	title='Search'
	hideTitle
	class='mt-4 mb-auto max-w-2xl md:mt-[10svh] md:max-h-[80svh]'
	data-search>
	<Input
		slot='header'
		variant='bare'
		class='min-w-0 flex-auto focus-visible:outline-none'
		type='text'
		role='searchbox'
		aria-label='Search zinn.sh'
		placeholder='Search'
		autocomplete='off'
		spellcheck='false'
		enterkeyhint='search'
		autofocus
		data-search-input
	/>
	<p class='p-3 text-sm empty:hidden md:px-5' role='status' data-search-status></p>
	<ol data-search-results></ol>

	<div
		class='sticky bottom-0 flex flex-wrap items-center gap-x-4 gap-y-1.5 border-t border-pewter bg-limestone px-3 py-2 text-xs text-muted-foreground md:px-5'
		aria-hidden='true'>
		<span class='inline-flex items-center gap-1.5 data-muted:opacity-40' data-search-item-keys>
			<span class='flex items-center gap-0.5'>
				<Kbd>↑</Kbd>
				<Kbd>↓</Kbd>
			</span>
			<span>move</span>
		</span>
		<span class='inline-flex items-center gap-1.5 data-muted:opacity-40' data-search-item-keys>
			<Kbd>↵</Kbd>
			<span>open</span>
		</span>
		<span class='ml-auto inline-flex items-center gap-1.5'>
			<Kbd>Esc</Kbd>
			<span>close</span>
		</span>
	</div>

	<template data-search-page>
		<li class='border-t border-pewter/40 first:border-t-0'>
			<a class:list={[resultLinkClass, "p-3 md:px-5"]} data-search-link>
				<span class='block font-mono text-xs' data-search-title></span>
				<span class={excerptClass} data-search-excerpt></span>
			</a>
			<ul data-search-sections></ul>
		</li>
	</template>

	<template data-search-section>
		<li>
			<a class:list={[resultLinkClass, "py-2 pr-3 pl-6 md:pr-5 md:pl-8"]} data-search-link>
				<span class='block font-mono text-xs' data-search-title></span>
				<span class={excerptClass} data-search-excerpt></span>
			</a>
		</li>
	</template>

	<template data-search-suggestions>
		{
			suggestions.map((suggestion) => (
				<li class='border-t border-pewter/40 first:border-t-0'>
					<a class:list={[resultLinkClass, "p-3 md:px-5"]} href={suggestion.href} data-search-link>
						<span class='block font-mono text-xs'>{suggestion.title}</span>
						<span class={excerptClass}>{suggestion.excerpt}</span>
					</a>
				</li>
			))
		}
	</template>
</Dialog>

<script is:inline>
	window.importPagefind = () => import("/pagefind/pagefind.js");
</script>

<script>
	import type { PagefindResult } from "./pagefind";

	import { trackEvent } from "../../scripts/analytics";
	import { loadPagefind, orderResults, sectionsToShow, withTextFragment } from "./pagefind";

	const dialog = document.querySelector<HTMLDialogElement>("[data-search]")!;
	const openButton = document.querySelector<HTMLButtonElement>("[data-search-open]")!;
	const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
	const status = dialog.querySelector<HTMLElement>("[data-search-status]")!;
	const results = dialog.querySelector<HTMLOListElement>("[data-search-results]")!;
	const pageTemplate = dialog.querySelector<HTMLTemplateElement>("[data-search-page]")!;
	const sectionTemplate = dialog.querySelector<HTMLTemplateElement>("[data-search-section]")!;
	const suggestionsTemplate = dialog.querySelector<HTMLTemplateElement>("[data-search-suggestions]")!;
	const itemKeys = dialog.querySelectorAll<HTMLElement>("[data-search-item-keys]");

	let activeLink: HTMLAnchorElement | null = null;
	let listReady = false;

	function fillLink(template: HTMLTemplateElement, url: string, title: string, excerpt: string) {
		const item = template.content.cloneNode(true) as DocumentFragment;
		item.querySelector<HTMLAnchorElement>("[data-search-link]")!.href = url;
		item.querySelector<HTMLElement>("[data-search-title]")!.textContent = title;
		const excerptElement = item.querySelector<HTMLElement>("[data-search-excerpt]")!;

		if (excerpt) {
			// Pagefind escapes the page text and adds only mark elements
			excerptElement.innerHTML = excerpt;
		} else {
			excerptElement.remove();
		}

		return item;
	}

	function renderPage(page: PagefindResult, query: string) {
		const sections = sectionsToShow(page, query);
		const item = fillLink(
			pageTemplate,
			withTextFragment(page.url, page.excerpt),
			page.meta.title,
			sections.length > 0 ? "" : page.excerpt
		);
		const list = item.querySelector<HTMLUListElement>("[data-search-sections]")!;

		for (const section of sections) {
			list.append(
				fillLink(sectionTemplate, withTextFragment(section.url, section.excerpt), section.title, section.excerpt)
			);
		}

		return item;
	}

	function resultLinks() {
		return Array.from(results.querySelectorAll<HTMLAnchorElement>("[data-search-link]"));
	}

	function setActive(link: HTMLAnchorElement | null) {
		if (activeLink === link) {
			return;
		}

		activeLink?.removeAttribute("data-active");
		activeLink = link;

		if (link) {
			link.setAttribute("data-active", "");
			input.setAttribute("aria-activedescendant", link.id);

			if (dialog.open) {
				link.scrollIntoView({ block: "nearest" });
			}
			return;
		}

		input.removeAttribute("aria-activedescendant");
	}

	function setItemsMuted(muted: boolean) {
		for (const keys of itemKeys) {
			keys.toggleAttribute("data-muted", muted);
		}
	}

	function showLinks(children: Array<Node>, message: string) {
		status.textContent = message;
		results.replaceChildren(...children);

		const links = resultLinks();
		links.forEach((link, index) => {
			link.id = `site-search-result-${index}`;
		});

		listReady = true;
		setItemsMuted(links.length === 0);
		setActive(links[0] ?? null);
	}

	function showSuggestions(message = "Suggested links") {
		showLinks(Array.from(suggestionsTemplate.content.cloneNode(true).childNodes), message);
	}

	function showPages(message: string, query: string, pages: Array<PagefindResult>) {
		showLinks(
			pages.map((page) => renderPage(page, query)),
			message
		);
	}

	// Identifies the newest query, so a slower earlier one cannot replace its results
	let latestQuery = 0;

	async function runSearch(query: string) {
		const thisQuery = ++latestQuery;

		if (!query) {
			showSuggestions();
			return;
		}

		try {
			const pagefind = await loadPagefind();
			const search = await pagefind.debouncedSearch(query);

			// Pagefind returns null for a query that a newer one replaced during its debounce.
			if (!search) {
				return;
			}

			const pages = await Promise.all(search.results.map((result) => result.data()));

			if (thisQuery === latestQuery) {
				if (pages.length === 0) {
					trackEvent("search-empty");
				}
				showPages(pages.length > 0 ? "" : `No results for “${query}”.`, query, orderResults(query, pages));
			}
		} catch {
			if (thisQuery === latestQuery) {
				showSuggestions("Search is unavailable.");
			}
		}
	}

	function openSearch() {
		if (!dialog.open) {
			trackEvent("search-open");
			dialog.showModal();

			if (!input.value.trim()) {
				showSuggestions();
			}

			loadPagefind().catch(() => showSuggestions("Search is unavailable."));
		}

		input.select();
	}

	openButton.addEventListener("click", openSearch);

	input.addEventListener("input", () => {
		// The visible links belong to the previous query until the new results render
		listReady = false;
		status.textContent = "";
		setActive(null);
		setItemsMuted(true);
		void runSearch(input.value.trim());
	});

	// Leave modified keys to the browser and to text selection
	function isPlainKey(event: KeyboardEvent) {
		return !event.metaKey && !event.ctrlKey && !event.altKey && !event.shiftKey;
	}

	function moveActive(step: -1 | 1) {
		const links = resultLinks();
		if (links.length === 0) {
			return false;
		}

		const currentIndex = activeLink ? links.indexOf(activeLink) : -1;
		let nextIndex;

		if (currentIndex === -1) {
			nextIndex = step === 1 ? 0 : links.length - 1;
		} else {
			nextIndex = (currentIndex + step + links.length) % links.length;
		}

		setActive(links[nextIndex]!);
		return true;
	}

	input.addEventListener("keydown", (event) => {
		if (!listReady || event.isComposing || !isPlainKey(event)) {
			return;
		}

		if (event.key === "ArrowDown") {
			if (moveActive(1)) {
				event.preventDefault();
			}
			return;
		}

		if (event.key === "ArrowUp") {
			if (moveActive(-1)) {
				event.preventDefault();
			}
			return;
		}

		if (event.key === "Enter" && activeLink) {
			event.preventDefault();
			activeLink.click();
		}
	});

	results.addEventListener("pointerover", (event) => {
		const link = (event.target as Element).closest<HTMLAnchorElement>("[data-search-link]");

		if (link) {
			setActive(link);
		}
	});

	document.addEventListener("keydown", (event) => {
		if ((event.metaKey || event.ctrlKey) && !event.shiftKey && !event.altKey && event.key.toLowerCase() === "k") {
			event.preventDefault();
			openSearch();
		}
	});

	// A link to a section of the current page does not reload it, so the dialog has to close itself.
	results.addEventListener("click", (event) => {
		const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-search-link]");

		if (!link) {
			return;
		}

		if (input.value.trim()) {
			const position = resultLinks().indexOf(link) + 1;
			// The text directive names the matched sentence, which the event does not need
			const anchor = link.hash.split(":~:")[0];
			trackEvent("search-result", { page: `${link.pathname}${anchor}`, position });
		}

		const openedHere = !(event.metaKey || event.ctrlKey || event.shiftKey || event.altKey);
		if (openedHere) {
			dialog.close();
		}
	});
</script>
