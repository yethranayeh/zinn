---
import CornerSun from "./CornerSun.astro";

interface Props {
	id?: string;
	labelledBy: string;
	surface?: "limestone" | "bone";
	split?: boolean;
	first?: boolean;
	decorated?: boolean;
}

const { id, labelledBy, surface = "limestone", split = false, first = false, decorated = false } = Astro.props;
---

<section id={id} aria-labelledby={labelledBy} class='relative border-t border-soot bg-limestone'>
	<div class='site-container relative'>
		<div
			aria-hidden='true'
			class:list={[
				"reading-frame pointer-events-none absolute inset-y-0 inset-x-2.5 border-x border-pewter md:inset-x-8",
				{ "frame-start": first },
				surface === "bone" ? "bg-bone" : "bg-limestone"
			]}>
			{decorated && <CornerSun />}
		</div>
		<div class:list={["relative py-4 md:py-20", { "grid gap-8 xl:grid-cols-2 xl:gap-12": split }]}>
			<slot />
		</div>
	</div>
</section>
