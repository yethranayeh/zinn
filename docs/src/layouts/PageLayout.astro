---
import type { ComponentProps } from "astro/types";
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

type Props = ComponentProps<typeof BaseLayout>;

const metadata = Astro.props;
---

<BaseLayout {...metadata}>
	<main class='flex min-h-svh flex-col px-6 pb-6 md:px-12 md:pb-8 lg:px-24'>
		<SiteHeader />

		<div class='my-auto w-full max-w-3xl pt-10 pb-14 md:pt-14 md:pb-16 2xl:ml-32'>
			<slot />
		</div>

		<SiteFooter class='mt-auto' links={!metadata.noindex} />
	</main>
</BaseLayout>
