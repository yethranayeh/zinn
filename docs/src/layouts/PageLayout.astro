---
import type { ComponentProps } from "astro/types";
import BaseLayout from "./BaseLayout.astro";
import Branding from "../components/Branding.astro";
import FooterLinks from "../components/FooterLinks.astro";
import Separator from "../components/Separator.astro";

type Props = ComponentProps<typeof BaseLayout> & {
	linkHome?: boolean;
};

const { linkHome = true, ...metadata } = Astro.props;
---

<BaseLayout {...metadata}>
	<main class='flex min-h-svh flex-col px-6 pt-8 pb-6 md:px-12 md:pt-10 md:pb-8 lg:px-24'>
		<header><Branding linked={linkHome} /></header>
		<div class='my-auto w-full max-w-3xl pt-16 pb-14 md:pt-24 md:pb-16 2xl:ml-32'>
			<slot />
		</div>
		<footer class:list={["mt-auto", !metadata.noindex && "flex flex-wrap items-center justify-between gap-5"]}>
			<div class='flex items-center gap-5'>
				<span class='shrink-0 font-mono text-xs tracking-widest'>zinn.sh</span>
				{
					!metadata.noindex && (
						<>
							<>
								<Separator orientation='vertical' />
								<FooterLinks />
							</>
						</>
					)
				}
			</div>
		</footer>
	</main>
</BaseLayout>
