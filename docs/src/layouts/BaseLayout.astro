---
import "../styles/global.css";
import { isProductionSite, projectLinks } from "../config/site";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const markdownPath = Astro.url.pathname === "/" ? "/index.md" : `${Astro.url.pathname.replace(/\/$/, "")}.md`;
const socialImageUrl = new URL("/social/zinn.png", Astro.site);
const socialImageAlt =
	"Zinn | A kanban workflow in the terminal. Installation and zinn --help on a dark terminal panel.";
const website = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Zinn",
	url: Astro.site?.href,
	description,
	inLanguage: "en"
};
const softwareApplication = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Zinn",
	url: Astro.site?.href,
	description,
	applicationCategory: "DeveloperApplication",
	softwareRequirements: "Node.js >=24.15.0",
	isAccessibleForFree: true,
	license: projectLinks.license,
	sameAs: [projectLinks.github, projectLinks.npm]
};
const homepageStructuredData = [website, softwareApplication];
---

<!doctype html>
<html lang='en' class='bg-limestone font-sans text-soot scheme-light [font-synthesis:none]'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<meta name='theme-color' content='#e8e0cc' />
		<meta name='description' content={description} />
		{(!isProductionSite || noindex) && <meta name='robots' content='noindex' />}
		<title>{title}</title>
		{!noindex && <link rel='canonical' href={canonicalUrl.href} />}
		<link rel='describedby' href='/llms.txt' />
		{!noindex && <link rel='alternate' type='text/markdown' href={markdownPath} />}
		{isProductionSite && <link rel='sitemap' href='/sitemap-index.xml' />}
		<meta property='og:type' content='website' />
		<meta property='og:site_name' content='Zinn' />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		{!noindex && <meta property='og:url' content={canonicalUrl.href} />}
		<meta property='og:image' content={socialImageUrl.href} />
		<meta property='og:image:type' content='image/png' />
		<meta property='og:image:width' content='1200' />
		<meta property='og:image:height' content='630' />
		<meta property='og:image:alt' content={socialImageAlt} />
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={description} />
		<meta name='twitter:image' content={socialImageUrl.href} />
		<meta name='twitter:image:alt' content={socialImageAlt} />
		{
			Astro.url.pathname === "/" &&
				!noindex &&
				homepageStructuredData.map((data) => (
					<script type='application/ld+json' is:inline set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />
				))
		}
		<link rel='icon' href='/favicon.svg' type='image/svg+xml' />
		<link rel='preload' href='/fonts/AlanSans.ttf' as='font' type='font/ttf' crossorigin />
		<link rel='preload' href='/fonts/monoMMM_5.ttf' as='font' type='font/ttf' crossorigin />
		{
			isProductionSite && (
				<script
					is:inline
					defer
					src='https://cloud.umami.is/script.js'
					data-website-id='2d789988-60f4-4ed7-80e1-c87cc64871d6'
					data-domains='zinn.sh'
					data-do-not-track='true'
				/>
			)
		}
	</head>
	<body class='selection:bg-soot selection:text-limestone'>
		<slot />
	</body>
</html>
