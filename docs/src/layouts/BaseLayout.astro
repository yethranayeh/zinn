---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { isProductionSite, projectLinks } from "../config/site";

interface Props {
	/** The page name. The document title is `{title} | Zinn` unless `fullTitle` is given. */
	title: string;
	/** Replaces the generated document title. */
	fullTitle?: string;
	description: string;
	noindex?: boolean;
	/** Social image path under the site root. Defaults to the site card. */
	socialImage?: string;
	/** Alt text for the social image. */
	socialImageAlt?: string;
}

const {
	title,
	fullTitle,
	description,
	noindex = false,
	socialImage = "/social/zinn.png",
	socialImageAlt = "Zinn | A kanban workflow in the terminal. Install and zinn --help on a dark terminal panel."
} = Astro.props;
const documentTitle = fullTitle ?? `${title} | Zinn`;
// Since the page renders inside this layout, breadcrumbs read the page name from here
Astro.locals.pageTitle = title;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const markdownPath = Astro.url.pathname === "/" ? "/index.md" : `${Astro.url.pathname.replace(/\/$/, "")}.md`;
const socialImageUrl = new URL(socialImage, Astro.site);
const website = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Zinn",
	url: Astro.site?.href,
	description,
	inLanguage: "en"
};
const softwareApplication = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Zinn",
	url: Astro.site?.href,
	description,
	applicationCategory: "DeveloperApplication",
	softwareRequirements: "Node.js >=24.15.0",
	isAccessibleForFree: true,
	license: projectLinks.license,
	sameAs: [projectLinks.github, projectLinks.npm]
};
const homepageStructuredData = [website, softwareApplication];
---

<!doctype html>
<html lang='en' class='bg-limestone font-sans text-soot scheme-light [font-synthesis:none]'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<meta name='theme-color' content='#e8e0cc' />
		<meta name='description' content={description} />
		{(!isProductionSite || noindex) && <meta name='robots' content='noindex' />}
		<title>{documentTitle}</title>
		{!noindex && <link rel='canonical' href={canonicalUrl.href} />}
		<link rel='describedby' href='/llms.txt' />
		{!noindex && <link rel='alternate' type='text/markdown' href={markdownPath} />}
		{isProductionSite && <link rel='sitemap' href='/sitemap-index.xml' />}
		<meta property='og:type' content='website' />
		<meta property='og:site_name' content='Zinn' />
		<meta property='og:title' content={documentTitle} />
		<meta property='og:description' content={description} />
		{!noindex && <meta property='og:url' content={canonicalUrl.href} />}
		<meta property='og:image' content={socialImageUrl.href} />
		<meta property='og:image:type' content='image/png' />
		<meta property='og:image:width' content='1200' />
		<meta property='og:image:height' content='630' />
		<meta property='og:image:alt' content={socialImageAlt} />
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:title' content={documentTitle} />
		<meta name='twitter:description' content={description} />
		<meta name='twitter:image' content={socialImageUrl.href} />
		<meta name='twitter:image:alt' content={socialImageAlt} />
		{
			Astro.url.pathname === "/" &&
				!noindex &&
				homepageStructuredData.map((data) => (
					<script type='application/ld+json' is:inline set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />
				))
		}
		<link rel='icon' href='/favicon.svg' type='image/svg+xml' />
		<link rel='preload' href='/fonts/AlanSans.ttf' as='font' type='font/ttf' crossorigin />
		<link rel='preload' href='/fonts/monoMMM_5.ttf' as='font' type='font/ttf' crossorigin />
		{
			Astro.url.pathname === "/" && (
				<link rel='preload' href='/fonts/Doto.woff2' as='font' type='font/woff2' crossorigin />
			)
		}
		{
			isProductionSite && (
				<script
					is:inline
					defer
					src='https://cloud.umami.is/script.js'
					data-website-id='2d789988-60f4-4ed7-80e1-c87cc64871d6'
					data-domains='zinn.sh'
					data-do-not-track='true'
				/>
			)
		}
	</head>
	<body class='flex min-h-svh flex-col selection:bg-soot selection:text-limestone'>
		<SiteHeader />

		<main class='flex min-w-0 flex-1 flex-col'>
			<slot />
		</main>

		<SiteFooter links={!noindex}>
			<slot name='footer' />
		</SiteFooter>

		<script is:inline src='/console/consoleimg.min.js'></script>
		<script is:inline>
			if (navigator.userAgent.indexOf("Firefox") > 0) {
				consoleimg.load("/console/spider-ff.gif", { size: 150 });
			} else {
				consoleimg.load("/console/spider.gif", { size: 150 });
			}
		</script>
	</body>
</html>
