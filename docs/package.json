{
	"name": "@zinn-dev/docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun astro dev --host 127.0.0.1",
		"build": "bun --bun astro build && bunx pagefind",
		"check": "bun --bun astro check",
		"test": "PUBLIC_SITE_ENV=production bun run build && bun run foundry:build && bun tests/run.ts",
		"deploy": "bun run test && bunx wrangler deploy",
		"preview": "bun --bun astro preview --host 127.0.0.1",
		"foundry:dev": "bun --bun astro dev --config foundry.config.mjs --host 127.0.0.1 --port 4322 --ignore-lock",
		"foundry:build": "bun --bun astro build --config foundry.config.mjs",
		"foundry:deploy": "bun run test && bunx wrangler deploy --config wrangler.foundry.jsonc"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.3",
		"@astrojs/mdx": "8.0.3",
		"@astrojs/sitemap": "3.7.4",
		"astro": "^7.3.5",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@resvg/resvg-js": "2.6.2",
		"@tailwindcss/vite": "^4.3.3",
		"pagefind": "1.6.0",
		"satori": "0.60.0",
		"typescript": "^5",
		"wrangler": "4.147.0"
	}
}
