{
	"name": "@zinn-dev/docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun astro dev --host 127.0.0.1",
		"build": "bun --bun astro build",
		"check": "bun --bun astro check",
		"test": "PUBLIC_SITE_ENV=production bun run build && bun tests/run.ts",
		"deploy": "PUBLIC_SITE_ENV=production bun run build && bunx wrangler deploy",
		"preview": "bun --bun astro preview --host 127.0.0.1"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"astro": "^7.3.5",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@tailwindcss/vite": "^4.3.3",
		"typescript": "^5",
		"wrangler": "4.147.0"
	}
}
