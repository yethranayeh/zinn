---
import { uiComponents } from "../ui";

interface Props {
	/** The component's folder in src/components/ui. */
	folder: string;
}

const { folder } = Astro.props;
const component = uiComponents.find((entry) => entry.folder === folder);
if (!component) {
	throw new Error(`No component in src/components/ui/${folder}`);
}
---

<header class='flex flex-col gap-4'>
	<h1 class='text-3xl font-semibold md:text-4xl'>{component.name}</h1>
	<p class='font-mono text-xs wrap-anywhere text-muted-foreground'>{component.source}</p>
	<div
		class='flex max-w-[65ch] flex-col gap-3 [&_code]:bg-[color-mix(in_srgb,currentColor_8%,transparent)] [&_code]:px-[0.22em] [&_code]:py-[0.05em] [&_code]:text-[0.85em]'>
		<slot />
	</div>
</header>
