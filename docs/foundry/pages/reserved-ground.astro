---
import type { ReservedGroundTexture } from "../../src/components/ui/reserved-ground/variants";

import FoundryLayout from "../layouts/FoundryLayout.astro";
import ComponentHeading from "../components/ComponentHeading.astro";
import Specimen from "../components/Specimen.astro";
import ReservedGround from "../../src/components/ui/reserved-ground/ReservedGround.astro";

import { reservedGroundVariants } from "../../src/components/ui/reserved-ground/variants";

const textures = Object.keys(reservedGroundVariants.variants.texture) as ReservedGroundTexture[];
---

<FoundryLayout
	title='ReservedGround'
	description='ReservedGround is a decorative texture for space left empty on purpose.'>
	<ComponentHeading folder='reserved-ground'>
		<p>
			A decorative texture that marks space as left empty on purpose, hidden from assistive technology. It has no size
			of its own, so the caller gives it one, usually by filling a positioned parent or a flex column.
		</p>
		<p>
			Card applies it for you. Use it directly when a layout has space of its own to fill, as the changelog rail does.
		</p>
	</ComponentHeading>

	<div class='grid gap-4 md:grid-cols-2'>
		{
			textures.map((texture) => (
				<Specimen label={`<ReservedGround texture="${texture}" />`} block>
					<div class='border border-soot'>
						<ReservedGround texture={texture} class='h-32' />
					</div>
				</Specimen>
			))
		}
	</div>
</FoundryLayout>
