---
import globalCss from "../../src/styles/global.css?raw";
import FoundryLayout from "../layouts/FoundryLayout.astro";
import { uiComponents } from "../ui";

// The palette and typefaces come from the @theme block, so this page lists what the site defines.
const theme = globalCss.match(/@theme \{([\s\S]*?)\n\}/)?.[1] ?? "";
const colors = [...theme.matchAll(/(?:\/\* (.+?) \*\/\s*)?--color-([\w-]+): ([^;]+);/g)].map(([, note, name, value]) => ({
	name,
	note,
	value: value.replace(/^var\(--color-([\w-]+)\)$/, "$1")
}));
const typefaces = [...theme.matchAll(/--font-([\w-]+): "([^"]+)"/g)].map(([, name, family]) => ({ name, family }));
---

<FoundryLayout description="Zinn's design system, rendered from the components zinn.sh is built with.">
	<header class='flex max-w-[65ch] flex-col gap-4'>
		<h1 class='text-3xl font-semibold md:text-4xl'>Foundry</h1>
		<p>Zinn's design system. Every specimen here is rendered from the same components zinn.sh is built with.</p>
	</header>

	<section class='flex flex-col gap-4' aria-labelledby='components'>
		<h2 id='components' class='text-xl font-semibold'>Components</h2>
		<ul class='grid border-t border-l border-soot/20 sm:grid-cols-2 lg:grid-cols-3'>
			{
				uiComponents.map((component) => (
					<li class='border-r border-b border-soot/20'>
						<a href={`/${component.folder}/`} class='block p-4 font-mono text-sm'>
							{component.name}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class='flex flex-col gap-4' aria-labelledby='palette'>
		<h2 id='palette' class='text-xl font-semibold'>Palette</h2>
		<ul class='grid gap-4 sm:grid-cols-2 lg:grid-cols-4'>
			{
				colors.map((color) => (
					<li class='flex flex-col gap-2'>
						<span class='h-16 border border-soot/20' style={`background-color: var(--color-${color.name})`} />
						<span class='font-mono text-xs'>{color.name}</span>
						<span class='font-mono text-xs text-muted-foreground'>{color.value}</span>
						{color.note && <span class='text-sm text-muted-foreground'>{color.note}</span>}
					</li>
				))
			}
		</ul>
	</section>

	<section class='flex flex-col gap-4' aria-labelledby='type'>
		<h2 id='type' class='text-xl font-semibold'>Type</h2>
		<ul class='flex flex-col gap-6'>
			{
				typefaces.map((typeface) => (
					<li class='flex flex-col gap-2'>
						<span class='font-mono text-xs text-muted-foreground'>
							font-{typeface.name}: {typeface.family}
						</span>
						<span class='text-2xl wrap-anywhere' style={`font-family: var(--font-${typeface.name})`}>
							A kanban workflow in the terminal
						</span>
					</li>
				))
			}
		</ul>
	</section>
</FoundryLayout>
