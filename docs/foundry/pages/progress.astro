---
import Progress from "../../src/components/ui/progress/Progress.astro";
import Button from "../../src/components/ui/button/Button.astro";
import ComponentHeading from "../components/ComponentHeading.astro";
import Specimen from "../components/Specimen.astro";
import FoundryLayout from "../layouts/FoundryLayout.astro";
---

<FoundryLayout title='Progress' description='Progress is a bar filled to a value from 0 to 1.'>
	<ComponentHeading folder='progress'>
		<p>
			A bar filled to a value from 0 to 1, solid up to the value with scattered dots beyond it. A new value fills or
			clears in dots over a few stepped frames, and with reduced motion it jumps straight to the value.
		</p>
		<p>
			The figure and the label stay outside the component, and spacing comes in through <code>class</code>. The page
			script calls <code>setupProgress(canvas)</code> for the starting value, then <code>set(value)</code> on the returned
			handle for each new one.
		</p>
	</ComponentHeading>

	<div class='grid gap-4'>
		<Specimen label='<Progress value={0} />' block>
			<Progress value={0} />
		</Specimen>

		<Specimen label='<Progress value={1 / 3} />' block>
			<Progress value={1 / 3} />
		</Specimen>

		<Specimen label='<Progress value={1} />' block>
			<Progress value={1} />
		</Specimen>

		<Specimen label='<Progress> with buttons that set 0, 1/3, 2/3 and 1' block>
			<div class='flex flex-col gap-4'>
				<Progress value={1 / 3} data-progress-demo />
				<div class='flex flex-wrap gap-2'>
					<Button variant='outline' data-progress-value={String(0)}>0</Button>
					<Button variant='outline' data-progress-value={String(1 / 3)}>1/3</Button>
					<Button variant='outline' data-progress-value={String(2 / 3)}>2/3</Button>
					<Button variant='outline' data-progress-value={String(1)}>1</Button>
				</div>
			</div>
		</Specimen>
	</div>
</FoundryLayout>

<script>
	import { setupProgress } from "../../src/components/ui/progress/progress";

	const demo = document.querySelector<HTMLCanvasElement>("[data-progress-demo]");
	const progress = demo ? setupProgress(demo) : undefined;

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>("[data-progress]")) {
		if (canvas !== demo) {
			setupProgress(canvas);
		}
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-progress-value]")) {
		button.addEventListener("click", () => progress?.set(Number(button.dataset.progressValue)));
	}
</script>
