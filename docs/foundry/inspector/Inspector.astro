---
import { twMerge } from "tailwind-merge";
import Kbd from "../../src/components/ui/kbd/Kbd.astro";

interface Props {
	defaultInspecting?: boolean;
	class?: string;
}

const { defaultInspecting = true, class: className } = Astro.props;
---

<section
	class='grid grid-cols-[2.5rem_minmax(0,1fr)] grid-rows-[auto_1.5rem_auto]'
	data-stage-shell
	aria-label='Component inspector'>
	<div
		class='col-span-2 flex flex-wrap items-center gap-4 border-b border-soot px-3 py-1.5 font-mono text-[0.6875rem] text-pewter'>
		<span class='text-soot' data-readout aria-live='polite'></span>
		<div class='ml-auto flex flex-wrap items-center justify-end gap-2'>
			<button
				type='button'
				class='inline-flex cursor-pointer items-center gap-1.5 border border-soot bg-transparent px-2 py-0.5 font-mono text-[0.6875rem] text-soot aria-pressed:bg-soot aria-pressed:text-limestone'
				data-toggle
				aria-pressed={defaultInspecting ? "true" : "false"}>
				Inspect <Kbd>I</Kbd>
			</button>
			<button
				type='button'
				class='inline-flex cursor-pointer items-center gap-1.5 border border-soot bg-transparent px-2 py-0.5 font-mono text-[0.6875rem] text-soot aria-pressed:bg-soot aria-pressed:text-limestone disabled:cursor-not-allowed disabled:opacity-40'
				data-explode
				aria-pressed='false'
				disabled>
				Explode <Kbd>E</Kbd>
			</button>
			<button
				type='button'
				class='inline-flex cursor-pointer items-center gap-1.5 border border-soot bg-transparent px-2 py-0.5 font-mono text-[0.6875rem] text-soot aria-pressed:bg-soot aria-pressed:text-limestone disabled:cursor-not-allowed disabled:opacity-40'
				data-trace
				aria-pressed='false'
				disabled>
				Trace <Kbd>T</Kbd>
			</button>
		</div>
	</div>

	<div class='ruler ruler-x col-start-2 row-start-2' data-ruler-x aria-hidden='true'></div>
	<div class='ruler ruler-y col-start-1 row-start-3' data-ruler-y aria-hidden='true'></div>

	<div
		class={twMerge(
			"relative col-start-2 row-start-3 min-h-[30rem] overflow-hidden border border-soot bg-limestone px-6 pt-10 pb-36 sm:px-12 sm:pt-14",
			className
		)}
		data-stage
		data-inspecting={defaultInspecting ? "on" : "off"}>
		<div class='relative z-10' data-stage-content>
			<slot />
		</div>
	</div>
</section>

<script>
	import { drawDrafting } from "./drafting";
	import { drawExplode, type ExplodeHandle } from "./explode";
	import { partsOf } from "./measure";
	import { startTabTrace, type TabTraceHandle } from "./trace";

	const INPUT_TAGS = /^(INPUT|TEXTAREA|SELECT)$/;

	for (const shell of document.querySelectorAll<HTMLElement>("[data-stage-shell]")) {
		const stage = shell.querySelector<HTMLElement>("[data-stage]");
		const readout = shell.querySelector<HTMLElement>("[data-readout]");
		const toggle = shell.querySelector<HTMLButtonElement>("[data-toggle]");
		const explodeButton = shell.querySelector<HTMLButtonElement>("[data-explode]");
		const traceButton = shell.querySelector<HTMLButtonElement>("[data-trace]");
		if (!stage || !readout || !toggle || !explodeButton || !traceButton) {
			continue;
		}

		const content = stage.querySelector<HTMLElement>("[data-stage-content]");
		const targets = [...stage.querySelectorAll<HTMLElement>("[data-inspect]")];
		let active = targets[0];
		let cleanup: () => void = () => {};
		let pinned: HTMLElement | null = null;
		let explode: ExplodeHandle | null = null;
		let exploded = false;
		/** Set from the first stop of a trace until the strip is cleared. */
		let trace: TabTraceHandle | null = null;

		const unpin = () => {
			pinned?.removeAttribute("data-tooltip-open");
			pinned = null;
		};

		// The inspected tooltip needs a visible box to measure, so it is held open.
		const pin = () => {
			unpin();
			if (!active) {
				return;
			}
			const tooltip = active.matches("[data-tooltip]") ? active : active.querySelector<HTMLElement>("[data-tooltip]");
			if (!tooltip) {
				return;
			}
			tooltip.setAttribute("data-tooltip-open", "");
			pinned = tooltip;
		};

		const setExploded = (next: boolean, animate = true) => {
			const shouldExplode = next && (explode?.canExplode ?? false) && stage.dataset.inspecting !== "off";
			exploded = shouldExplode;
			explode?.setExploded(shouldExplode, animate);
			explodeButton.setAttribute("aria-pressed", String(shouldExplode));
			explodeButton.disabled = !explode?.canExplode || stage.dataset.inspecting === "off";
		};

		const render = () => {
			// A trace owns the stage until the strip is cleared.
			if (trace) {
				return;
			}

			cleanup();
			cleanup = () => {};

			if (stage.dataset.inspecting === "off") {
				unpin();

				explode = null;
				exploded = false;
				readout.textContent = "";
				explodeButton.setAttribute("aria-pressed", "false");
				explodeButton.disabled = true;

				return;
			}

			pin();

			if (!active) {
				explode = null;
				readout.textContent = "No targets";
				setExploded(false, false);
				return;
			}

			const drafting = drawDrafting(stage, active);
			const nextExplode = drawExplode(stage, active);
			explode = nextExplode;
			cleanup = () => {
				nextExplode.cleanup();
				drafting();
			};

			const name = active.dataset.inspect?.trim() || "element";
			const count = partsOf(active, stage.getBoundingClientRect()).length;
			readout.textContent = `${name} · ${count} ${count === 1 ? "part" : "parts"}`;

			explodeButton.disabled = !nextExplode.canExplode || stage.dataset.inspecting === "off";
			explodeButton.setAttribute("aria-pressed", String(exploded && nextExplode.canExplode));
			if (exploded && nextExplode.canExplode) {
				nextExplode.setExploded(true, false);
			} else {
				exploded = false;
			}
		};

		const updateTraceButton = () => {
			traceButton.disabled = stage.dataset.inspecting === "off";
			traceButton.setAttribute("aria-pressed", String(trace !== null));
		};

		const clearTrace = (focusButton = false) => {
			if (!trace) {
				return;
			}

			trace.clear();
			trace = null;
			updateTraceButton();
			render();
			if (focusButton) {
				traceButton.focus();
			}
		};

		const startTrace = () => {
			if (!content || stage.dataset.inspecting === "off") {
				return;
			}

			unpin();
			cleanup();
			cleanup = () => {};
			explode = null;
			exploded = false;
			explodeButton.setAttribute("aria-pressed", "false");
			explodeButton.disabled = true;

			trace = startTabTrace(stage, content, readout, { onClear: () => clearTrace(true) });
			updateTraceButton();
		};

		const toggleTrace = () => {
			if (stage.dataset.inspecting === "off") {
				return;
			}

			if (!trace) {
				startTrace();
				return;
			}

			if (trace.tracing) {
				trace.end();
				updateTraceButton();
				return;
			}

			clearTrace(true);
		};

		for (const target of targets) {
			target.addEventListener("pointerenter", () => {
				if (trace || active === target) {
					return;
				}
				active = target;
				render();
			});
		}

		explodeButton.addEventListener("click", () => {
			setExploded(!exploded, true);
		});

		traceButton.addEventListener("click", toggleTrace);

		toggle.addEventListener("click", () => {
			const next = stage.dataset.inspecting === "off";
			if (!next && trace) {
				trace.clear();
				trace = null;
			}
			stage.dataset.inspecting = next ? "on" : "off";
			toggle.setAttribute("aria-pressed", String(next));
			updateTraceButton();
			render();
		});

		document.addEventListener("keydown", (event) => {
			const target = event.target;
			if (target instanceof HTMLElement && (INPUT_TAGS.test(target.tagName) || target.isContentEditable)) {
				return;
			}
			if (event.metaKey || event.ctrlKey || event.altKey || event.repeat) {
				return;
			}
			if (event.key === "i" || event.key === "I") {
				toggle.click();
				return;
			}
			if ((event.key === "t" || event.key === "T") && stage.dataset.inspecting !== "off") {
				toggleTrace();
				return;
			}
			if ((event.key === "e" || event.key === "E") && stage.dataset.inspecting !== "off" && explode?.canExplode) {
				event.preventDefault();
				setExploded(!exploded, true);
			}
		});

		window.addEventListener("resize", () => requestAnimationFrame(render));
		window.addEventListener("pagehide", unpin);

		render();
		updateTraceButton();
		document.fonts.ready.then(render);
	}
</script>

<style is:global>
	:root {
		--tone-soot: var(--color-soot);
		--tone-clay: var(--color-clay);
		--tone-cinnabar: var(--color-cinnabar);
		--tone-pewter: var(--color-pewter);
		--tone-bronze: var(--color-bronze);
	}

	/* The overlay is built by script, so Tailwind never sees its classes. */
	.ov {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.ov-lines {
		overflow: visible;
	}

	.ov-under {
		z-index: 0;
	}

	.ov-over {
		z-index: 30;
	}

	.ov-labels {
		z-index: 31;
	}

	.ov-label.is-badge {
		min-width: 1.35rem;
		padding: 0 0.2rem;
		text-align: center;
		letter-spacing: 0.04em;
	}

	.ov-label {
		position: absolute;
		transform: translateY(-50%);
		padding: 0.05rem 0.375rem;
		border: 1px solid currentColor;
		background: var(--color-limestone);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1.5;
		white-space: nowrap;
	}

	.ov-label[data-anchor="middle"] {
		transform: translate(-50%, -50%);
	}

	.ov-label[data-anchor="end"] {
		transform: translate(-100%, -50%);
	}

	.ov-label.is-strong {
		background: var(--color-soot);
		color: var(--color-limestone);
		border-color: var(--color-soot);
	}

	@media (max-width: 30rem) {
		.ov-label[data-side="horizontal"] {
			display: none;
		}
	}

	.tone-soot {
		color: var(--tone-soot);
	}
	.tone-clay {
		color: var(--tone-clay);
	}
	.tone-cinnabar {
		color: var(--tone-cinnabar);
	}
	.tone-pewter {
		color: var(--tone-pewter);
	}
	.tone-bronze {
		color: var(--tone-bronze);
	}

	.ov-hatch {
		position: absolute;
		background-image: repeating-linear-gradient(-45deg, currentColor 0 1px, transparent 1px 5px);
		opacity: 0.55;
		mix-blend-mode: multiply;
	}

	.ov-card {
		position: absolute;
		left: 2.75rem;
		bottom: 1rem;
		width: 16.5rem;
		max-width: calc(100% - 3.75rem);
		padding: 0.6rem 0.7rem;
		border: 1px solid var(--color-soot);
		background: var(--color-limestone);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1.5;
	}

	.ov-card-kicker {
		margin: 0 0 0.4rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-pewter);
	}

	.ov-card dl {
		margin: 0;
	}

	.ov-card dl > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.ov-card dt {
		color: var(--color-pewter);
	}

	.ov-card dd {
		margin: 0;
	}

	.ov-explode {
		display: block;
		width: 100%;
		height: 100%;
		z-index: 29;
	}

	.ov-dot-labels {
		z-index: 32;
	}

	.ov-dot-label {
		position: absolute;
		transform: translateY(-100%);
		padding: 0.05rem 0.375rem;
		border: 1px solid currentColor;
		background: var(--color-limestone);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1.5;
		white-space: nowrap;
	}

	.ov-dot-label.is-thin {
		transform: translateY(-50%);
	}

	.ov-dot-label[data-tone="soot"] {
		color: var(--tone-soot);
	}
	.ov-dot-label[data-tone="clay"] {
		color: var(--tone-clay);
	}
	.ov-dot-label[data-tone="cinnabar"] {
		color: var(--tone-cinnabar);
	}
	.ov-dot-label[data-tone="pewter"] {
		color: var(--tone-pewter);
	}
	.ov-dot-label[data-tone="bronze"] {
		color: var(--tone-bronze);
	}

	.ov-dot-label b {
		margin-left: 0.4rem;
		font-weight: 400;
		opacity: 0.65;
	}

	/* The Tab trace tray is built by script, so Tailwind never sees its classes. */
	.ov-trace {
		position: fixed;
		right: 0.75rem;
		bottom: 0.75rem;
		z-index: 50;
		box-sizing: border-box;
		width: min(42.375rem, calc(100vw - 1.5rem));
		padding: 0.625rem;
		border: 1px solid var(--color-soot);
		background: var(--color-limestone);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1.5;
	}

	.ov-trace-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
	}

	.ov-trace-title {
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-pewter);
	}

	.ov-trace-status {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--color-soot);
	}

	.ov-trace-clear {
		flex: none;
		cursor: pointer;
		border: 1px solid var(--color-soot);
		background: transparent;
		padding: 0.05rem 0.375rem;
		font: inherit;
		color: var(--color-soot);
	}

	.ov-trace-row {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.375rem;
		min-height: 4.5rem;
	}

	/* Keep the focused stop clear of the fixed tray while a trace owns the page. */
	[data-trace-active] [data-inspect],
	[data-trace-active] :focus {
		scroll-margin-bottom: 9rem;
	}

	.ov-plate {
		flex: none;
		border-style: solid;
		border-color: var(--color-soot);
		background: var(--color-limestone);
	}

	.ov-plate-image {
		display: block;
		width: 100%;
	}

	.ov-plate-caption {
		display: flex;
		align-items: baseline;
		gap: 0.25rem;
		padding: 0 0.25rem;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		line-height: 0.875rem;
		color: var(--color-pewter);
	}

	.ov-plate-caption b {
		font-weight: 400;
		color: var(--color-soot);
	}

	.ov-plate-caption span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.ruler {
		position: relative;
		pointer-events: none;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--tone-pewter);
	}

	.ruler span {
		position: absolute;
		white-space: nowrap;
	}

	.ruler-x span {
		top: 0.25rem;
		transform: translateX(-50%);
	}

	.ruler-y span {
		width: 2.5rem;
		padding-right: 0.5rem;
		text-align: right;
		transform: translateY(-50%);
	}

	[data-inspecting="off"] .ov {
		display: none;
	}

	/* The demo recedes while the exploded plates carry the eye. */
	[data-exploded] > :not(.ov) {
		opacity: 0.22;
	}
</style>
