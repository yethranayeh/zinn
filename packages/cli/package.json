{
	"name": "@zinn-dev/cli",
	"version": "0.41.0-dev",
	"description": "A kanban workflow in the terminal. Experimental.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/yethranayeh/zinn/issues"
	},
	"author": {
		"name": "Alper Halil",
		"email": "contact@aktasalper.com",
		"url": "https://aktasalper.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yethranayeh/zinn.git",
		"directory": "packages/cli"
	},
	"keywords": [
		"kanban",
		"cli",
		"terminal",
		"bun"
	],
	"module": "index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts"
		}
	},
	"files": [
		"index.js",
		"index.d.ts",
		"src/**/*.js",
		"src/**/*.d.ts",
		"LICENSE"
	],
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"build": "bun build.ts",
		"prepublishOnly": "bun ../../scripts/verify-installed.ts",
		"prepack": "bun ../../scripts/prepare-release.ts"
	},
	"bin": {
		"zinn": "./index.ts"
	},
	"publishConfig": {
		"access": "public",
		"directory": "release-dist",
		"linkDirectory": false
	},
	"dependencies": {
		"@zinn-dev/core": "workspace:*",
		"zod": "4.6.4"
	}
}
