{
	"name": "@zinn-dev/cli",
	"version": "0.38.0",
	"description": "A kanban workflow in the terminal. Experimental.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/yethranayeh/zinn/issues"
	},
	"author": {
		"name": "Alper Halil",
		"email": "contact@aktasalper.com",
		"url": "https://aktasalper.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yethranayeh/zinn.git",
		"directory": "packages/cli"
	},
	"keywords": [
		"kanban",
		"cli",
		"terminal",
		"bun"
	],
	"module": "index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts"
		}
	},
	"files": [
		"index.ts",
		"src",
		"LICENSE",
		"release-stamp.json"
	],
	"type": "module",
	"scripts": {
		"prepack": "bun ../../scripts/release-stamp.ts write",
		"postpack": "bun ../../scripts/release-stamp.ts remove"
	},
	"bin": {
		"zinn": "./index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@zinn-dev/core": "workspace:*"
	}
}
