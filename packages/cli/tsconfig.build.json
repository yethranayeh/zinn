{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "dist",
		"allowJs": false,
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"noEmitOnError": true,
		"declaration": true,
		"resolveJsonModule": true,
		"paths": {
			"@zinn-dev/core": ["../core/dist/index.d.ts"]
		}
	},
	"include": ["index.ts", "src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
