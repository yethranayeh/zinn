{
	"name": "@zinn-dev/core",
	"version": "0.29.0-dev",
	"description": "Shared logic for zinn, a kanban workflow in the terminal. Experimental.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/yethranayeh/zinn/issues"
	},
	"author": {
		"name": "Alper Halil",
		"email": "contact@aktasalper.com",
		"url": "https://aktasalper.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yethranayeh/zinn.git",
		"directory": "packages/core"
	},
	"private": false,
	"type": "module",
	"scripts": {
		"build": "bun build.ts",
		"prepack": "bun ../../scripts/prepare-release.ts"
	},
	"module": "index.ts",
	"imports": {
		"#sqlite": {
			"bun": "./src/sqlite/bun.ts",
			"default": "./src/sqlite/node.ts"
		}
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts"
		}
	},
	"files": [
		"index.js",
		"index.d.ts",
		"src/**/*.js",
		"src/**/*.d.ts",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"directory": "dist",
		"linkDirectory": false
	},
	"dependencies": {
		"fractional-indexing": "4.0.0",
		"uuid": "14.0.3",
		"zod": "4.6.4"
	}
}
