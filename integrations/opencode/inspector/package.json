{
	"name": "@zinn-dev/opencode",
	"version": "0.3.1",
	"type": "module",
	"description": "Experimental Zinn task inspector for the OpenCode TUI.",
	"keywords": [
		"zinn",
		"opencode",
		"opencode-plugin",
		"tui",
		"kanban",
		"task-management",
		"ai-agents",
		"developer-tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yethranayeh/zinn.git",
		"directory": "integrations/opencode/inspector"
	},
	"bugs": {
		"url": "https://github.com/yethranayeh/zinn/issues"
	},
	"homepage": "https://zinn.sh/integrations/opencode/inspector",
	"exports": {
		"./tui": "./dist/tui.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun checks/build.mjs",
		"test": "bun test --timeout 120000 pkg tests",
		"typecheck": "bun ../../../scripts/typecheck.ts integrations/opencode/inspector",
		"test:package": "bun test --timeout 120000 tests/package.test.ts",
		"prepack": "bun run build",
		"prepublishOnly": "bun run build && bun checks/release.ts && bun run typecheck && bun run test"
	},
	"peerDependencies": {
		"@opencode/plugin": "2.2.0",
		"@opentui/core": "0.7.0",
		"@opentui/solid": "0.7.0",
		"solid-js": ">=1.9.0"
	},
	"peerDependenciesMeta": {
		"@opencode/plugin": {
			"optional": true
		}
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/preset-typescript": "7.27.1",
		"@opencode/plugin": "2.2.0",
		"@opencode/theme": "2.2.0",
		"@opentui/core": "0.7.0",
		"@opentui/solid": "0.7.0",
		"babel-preset-solid": "1.9.12",
		"solid-js": "^1.9.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
