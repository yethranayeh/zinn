{
	"name": "@zinn-dev/opencode",
	"version": "0.3.0-dev",
	"type": "module",
	"description": "Experimental Zinn task inspector for the OpenCode TUI.",
	"keywords": [
		"zinn",
		"opencode",
		"opencode-plugin",
		"tui",
		"kanban",
		"task-management",
		"ai-agents",
		"developer-tools"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yethranayeh/zinn.git",
		"directory": "integrations/opencode/inspector"
	},
	"bugs": {
		"url": "https://github.com/yethranayeh/zinn/issues"
	},
	"homepage": "https://zinn.sh/integrations/opencode/inspector",
	"exports": {
		"./tui": "./pkg/tui.tsx"
	},
	"files": [
		"pkg/types.ts",
		"pkg/options.ts",
		"pkg/data.ts",
		"pkg/session.ts",
		"pkg/scan.ts",
		"pkg/rows.ts",
		"pkg/theme.ts",
		"pkg/components.tsx",
		"pkg/dialogs.tsx",
		"pkg/commands.ts",
		"pkg/sidebar.tsx",
		"pkg/tui.tsx"
	],
	"scripts": {
		"test": "bun test --timeout 120000 pkg tests",
		"typecheck": "bun ../../../scripts/typecheck.ts integrations/opencode/inspector",
		"test:package": "bun test --timeout 120000 tests/package.test.ts",
		"prepublishOnly": "bun checks/release.ts && bun run typecheck && bun run test"
	},
	"peerDependencies": {
		"@opencode/plugin": "2.2.0",
		"@opentui/core": "0.7.0",
		"@opentui/solid": "0.7.0",
		"solid-js": ">=1.9.0"
	},
	"peerDependenciesMeta": {
		"@opencode/plugin": {
			"optional": true
		}
	},
	"devDependencies": {
		"@opencode/plugin": "2.2.0",
		"@opencode/theme": "2.2.0",
		"@opentui/core": "0.7.0",
		"@opentui/solid": "0.7.0",
		"solid-js": "^1.9.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
