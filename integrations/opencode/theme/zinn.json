{
	"$schema": "https://opencode.ai/theme.json",
	"name": "Zinn",
	"id": "zinn",
	"base": {
		"text": {
			"base": "$hue.neutral.100",
			"muted": "$hue.neutral.200",
			"faint": "$hue.neutral.300",
			"action": {
				"primary": {
					"base": "$hue.accent.100",
					"$focused": "$hue.neutral.900"
				},
				"secondary": {
					"base": "$hue.neutral.100"
				},
				"destructive": {
					"base": "$hue.red.100",
					"$hovered": "$hue.red.100",
					"$focused": "$hue.red.100"
				}
			},
			"formfield": {
				"base": "$hue.neutral.200",
				"$focused": "$hue.accent.100",
				"$selected": "$hue.green.100",
				"$disabled": "$hue.neutral.500"
			},
			"feedback": {
				"error": {
					"base": "$hue.red.100",
					"muted": "$hue.red.300"
				},
				"warning": {
					"base": "$hue.yellow.100",
					"muted": "$hue.yellow.300"
				},
				"success": {
					"base": "$hue.green.100",
					"muted": "$hue.green.300"
				},
				"info": {
					"base": "$hue.cyan.100",
					"muted": "$hue.cyan.300"
				}
			}
		},
		"background": {
			"base": "$hue.surface.100",
			"raised": {
				"base": "$hue.surface.300",
				"high": "$hue.surface.700",
				"max": "$hue.surface.900"
			},
			"action": {
				"primary": {
					"base": "$hue.accent.900",
					"$hovered": "$hue.accent.900",
					"$focused": "$hue.accent.200"
				},
				"secondary": {
					"base": "$hue.surface.600",
					"$hovered": "$hue.surface.700",
					"$focused": "$hue.surface.700"
				},
				"destructive": {
					"base": "$hue.red.900",
					"$hovered": "$hue.red.900",
					"$focused": "$hue.red.900"
				}
			},
			"formfield": {
				"base": "$hue.surface.500"
			},
			"feedback": {
				"error": {
					"base": "$hue.red.800"
				},
				"warning": {
					"base": "$hue.yellow.800"
				},
				"success": {
					"base": "$hue.green.800"
				},
				"info": {
					"base": "$hue.cyan.800"
				}
			}
		},
		"border": {
			"base": "$hue.surface.800"
		},
		"scrollbar": {
			"base": "$hue.surface.700"
		},
		"diff": {
			"text": {
				"added": "$hue.neutral.100",
				"removed": "$hue.neutral.100",
				"context": "$hue.neutral.200",
				"hunkHeader": "$hue.neutral.300"
			},
			"background": {
				"added": "$hue.added.700",
				"removed": "$hue.removed.700",
				"context": "$hue.surface.500"
			},
			"highlight": {
				"added": "$hue.added.800",
				"removed": "$hue.removed.800"
			},
			"lineNumber": {
				"text": "$hue.neutral.300",
				"background": {
					"added": "$hue.added.700",
					"removed": "$hue.removed.700"
				}
			}
		},
		"syntax": {
			"comment": "$hue.neutral.200",
			"keyword": "$hue.yellow.100",
			"function": "$hue.accent.100",
			"variable": "$hue.neutral.100",
			"string": "$hue.orange.100",
			"number": "$hue.orange.100",
			"type": "$hue.yellow.100",
			"operator": "$hue.neutral.200",
			"punctuation": "$hue.neutral.200"
		},
		"markdown": {
			"text": "$hue.neutral.100",
			"heading": "$hue.accent.100",
			"link": "$hue.accent.100",
			"linkText": "$hue.accent.100",
			"code": "$hue.green.100",
			"blockQuote": "$hue.neutral.200",
			"emphasis": "$hue.neutral.200",
			"strong": "$hue.accent.100",
			"horizontalRule": "$hue.surface.700",
			"listItem": "$hue.orange.100",
			"listEnumeration": "$hue.accent.100",
			"image": "$hue.accent.200",
			"imageText": "$hue.orange.100",
			"codeBlock": "$hue.green.100"
		},
		"categorical": ["seal", "patina", "murex", "ash"]
	},
